      "data": {
        "title": "判断优先级",
        "description": "根据工单优先级判断是否升级处理。",
        "conditions": [
          {
            "key": "highPriority",
            "label": "高优先级",
            "expression": "${priority == 'HIGH' || priority == 'URGENT'}",
            "outgoingEdgeId": "escalate"
          },
          {
            "key": "normalPriority",
            "label": "普通优先级",
            "expression": "${priority == 'NORMAL' || priority == 'LOW'}",
            "outgoingEdgeId": "verify"
          }
        ]
