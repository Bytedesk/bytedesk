      "data": {
        "title": "大额审批结果",
        "description": "判断大额报销审批是否全部通过。",
        "conditions": [
          {
            "key": "largeApproved",
            "label": "全部批准",
            "expression": "${cfoApproved == true && ceoApproved == true}",
            "outgoingEdgeId": "paymentProcess"
          },
          {
            "key": "largeRejected",
            "label": "有拒绝",
            "expression": "${cfoApproved == false || ceoApproved == false}",
            "outgoingEdgeId": "rejectEnd"
