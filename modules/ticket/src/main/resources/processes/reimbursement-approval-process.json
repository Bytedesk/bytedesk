        }
      },
      "data": {
        "title": "财务初审",
        "description": "财务人员审核报销单据的合规性。",
        "assigneeType": "role",
        "roleUid": "${financeGroupId}",
        "timeoutMinutes": 0,
        "timeoutAction": "remind",
        "allowDelegate": true,
        "allowAddSign": true,
        "commentRequired": true
      }
    },
    {
      "id": "financeReviewGateway",
      "type": "condition",
      "meta": {
        "position": {
          "x": 102.48829953198094,
          "y": 285
        }
      },
      "data": {
        "title": "财务初审结果",
        "description": "判断财务初审是否通过。",
        "conditions": [
          {
            "key": "financeApproved",
            "label": "初审通过",
            "expression": "${financeApproved == true}",
            "outgoingEdgeId": "checkAmountGateway"
          },
          {
            "key": "financeRejected",
            "label": "初审不通过",
            "expression": "${financeApproved == false}",
            "outgoingEdgeId": "rejectEnd"
          }
        ]
      }
    },
    {
      "id": "checkAmountGateway",
      "type": "condition",
      "meta": {
        "position": {
          "x": 486.1778471138845,
          "y": 354.3213728549142
        }
      },
      "data": {
        "title": "判断报销金额",
        "description": "根据报销金额选择小额或大额审批路径。",
        "conditions": [
          {
            "key": "smallAmount",
            "label": "小额报销（≤5000）",
            "expression": "${amount <= 5000}",
            "outgoingEdgeId": "managerApproval"
          },
          {
            "key": "largeAmount",
            "label": "大额报销（>5000）",
            "expression": "${amount > 5000}",
            "outgoingEdgeId": "parallelFork"
          }
        ]
      }
    },
    {
      "id": "managerApproval",
