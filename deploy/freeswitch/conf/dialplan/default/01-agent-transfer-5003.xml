<include>
  <extension name="agent-transfer-1010-alias" continue="false">
    <condition field="destination_number" expression="^1010$">
      <action application="log" data="INFO [IVR-WORKFLOW] redirect legacy agent extension 1010 to 5003" />
      <action application="transfer" data="5003 XML default" />
    </condition>
  </extension>

  <extension name="agent-transfer-5003" continue="false">
    <condition field="destination_number" expression="^5003$">
      <action application="export" data="dialed_extension=5003" />
      <action application="set" data="origination_caller_id_name=${caller_id_number}" />
      <action application="set" data="origination_caller_id_number=${caller_id_number}" />
      <action application="set" data="effective_caller_id_name=${caller_id_number}" />
      <action application="set" data="effective_caller_id_number=${caller_id_number}" />
      <action application="export" data="nolocal:origination_caller_id_name=${caller_id_number}" />
      <action application="export" data="nolocal:origination_caller_id_number=${caller_id_number}" />
      <action application="set" data="ringback=${us-ring}" />
      <action application="set" data="transfer_ringback=$${hold_music}" />
      <action application="set" data="call_timeout=30" />
      <action application="set" data="hangup_after_bridge=true" />
      <action application="set" data="continue_on_fail=true" />
      <action application="bridge" data="user/5003@${domain_name}" />
      <action application="answer" />
      <action application="sleep" data="1000" />
      <action application="bridge" data="loopback/app=voicemail:default ${domain_name} 5003" />
    </condition>
  </extension>
</include>