<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260323-drop-meet-room-invite-uid-not-null" author="copilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <or>
                <and>
                    <dbms type="mysql,mariadb"/>
                    <tableExists tableName="bytedesk_meet_room"/>
                    <columnExists tableName="bytedesk_meet_room" columnName="invite_uid"/>
                    <sqlCheck expectedResult="1"><![CDATA[
                        SELECT CASE WHEN EXISTS (
                            SELECT 1
                            FROM information_schema.columns
                            WHERE table_schema = DATABASE()
                              AND table_name = 'bytedesk_meet_room'
                              AND column_name = 'invite_uid'
                              AND is_nullable = 'NO'
                        ) THEN 1 ELSE 0 END
                    ]]></sqlCheck>
                </and>
                <and>
                    <dbms type="postgresql"/>
                    <tableExists tableName="bytedesk_meet_room"/>
                    <columnExists tableName="bytedesk_meet_room" columnName="invite_uid"/>
                    <sqlCheck expectedResult="1"><![CDATA[
                        SELECT CASE WHEN EXISTS (
                            SELECT 1
                            FROM information_schema.columns
                            WHERE table_schema = current_schema()
                              AND table_name = 'bytedesk_meet_room'
                              AND column_name = 'invite_uid'
                              AND is_nullable = 'NO'
                        ) THEN 1 ELSE 0 END
                    ]]></sqlCheck>
                </and>
                <and>
                    <dbms type="h2"/>
                    <tableExists tableName="bytedesk_meet_room"/>
                    <columnExists tableName="bytedesk_meet_room" columnName="invite_uid"/>
                    <sqlCheck expectedResult="1"><![CDATA[
                        SELECT CASE WHEN EXISTS (
                            SELECT 1
                            FROM information_schema.columns
                            WHERE table_schema = SCHEMA()
                              AND table_name = 'BYTEDESK_MEET_ROOM'
                              AND column_name = 'INVITE_UID'
                              AND is_nullable = 'NO'
                        ) THEN 1 ELSE 0 END
                    ]]></sqlCheck>
                </and>
            </or>
        </preConditions>

        <dropNotNullConstraint tableName="bytedesk_meet_room" columnName="invite_uid" columnDataType="varchar(64)"/>

        <rollback>
            <addNotNullConstraint tableName="bytedesk_meet_room" columnName="invite_uid" columnDataType="varchar(64)"/>
        </rollback>
    </changeSet>

</databaseChangeLog>