    <changeSet id="260611-add-ticket-statistics-department-index-mysql" author="githubcopilot" dbms="mysql">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_ticket_statistics"/>
            <columnExists tableName="bytedesk_ticket_statistics" columnName="org_uid"/>
            <columnExists tableName="bytedesk_ticket_statistics" columnName="statistic_type"/>
            <columnExists tableName="bytedesk_ticket_statistics" columnName="date"/>
            <columnExists tableName="bytedesk_ticket_statistics" columnName="hour"/>
            <columnExists tableName="bytedesk_ticket_statistics" columnName="is_deleted"/>
            <columnExists tableName="bytedesk_ticket_statistics" columnName="department_uid"/>
            <not>
                <indexExists tableName="bytedesk_ticket_statistics" indexName="idx_ticket_stats_org_type_date_hour_dept"/>
            </not>
        </preConditions>

        <sql><![CDATA[
            ALTER TABLE `bytedesk_ticket_statistics`
            ADD INDEX `idx_ticket_stats_org_type_date_hour_dept` (
                `org_uid`(64),
                `statistic_type`(32),
                `date`(16),
                `hour`,
                `is_deleted`,
                `department_uid`(64)
            )
        ]]></sql>
    </changeSet>

