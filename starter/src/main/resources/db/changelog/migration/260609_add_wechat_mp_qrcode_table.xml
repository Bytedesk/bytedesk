    <changeSet id="260609-create-wechat-mp-qrcode-table" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <not>
                <tableExists tableName="bytedesk_channel_wechat_mp_qrcode"/>
            </not>
        </preConditions>

        <createTable tableName="bytedesk_channel_wechat_mp_qrcode">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_wechat_mp_qrcode" nullable="false"/>
            </column>
            <column name="uuid" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_wechat_mp_qrcode_uuid"/>
            </column>
            <column name="version" type="INT" defaultValueNumeric="0"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="org_uid" type="VARCHAR(64)"/>
            <column name="user_uid" type="VARCHAR(64)"/>
            <column name="level_type" type="VARCHAR(64)"/>
            <column name="platform_type" type="VARCHAR(64)"/>
            <column name="name" type="VARCHAR(255)"/>
            <column name="app_uid" type="VARCHAR(64)"/>
            <column name="app_id" type="VARCHAR(128)"/>
            <column name="scene_str" type="VARCHAR(128)"/>
            <column name="scene_id" type="INT"/>
            <column name="custom_param" type="VARCHAR(255)"/>
            <column name="is_permanent" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="expire_seconds" type="INT"/>
            <column name="action_name" type="VARCHAR(64)"/>
            <column name="ticket" type="VARCHAR(255)"/>
            <column name="qrcode_url" type="VARCHAR(512)"/>
        </createTable>

        <createIndex tableName="bytedesk_channel_wechat_mp_qrcode" indexName="idx_wechat_mp_qrcode_app_uid">
            <column name="app_uid"/>
        </createIndex>
        <createIndex tableName="bytedesk_channel_wechat_mp_qrcode" indexName="idx_wechat_mp_qrcode_ticket">
            <column name="ticket"/>
        </createIndex>
    </changeSet>

