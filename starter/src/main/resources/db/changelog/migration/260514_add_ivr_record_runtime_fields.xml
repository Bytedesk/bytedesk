<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260514-add-ivr-record-runtime-fields" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_call_ivr_record"/>
        </preConditions>

        <addColumn tableName="bytedesk_call_ivr_record">
            <column name="extension_number" type="VARCHAR(64)"/>
            <column name="caller_id_number" type="VARCHAR(64)"/>
            <column name="workflow_uid" type="VARCHAR(64)"/>
            <column name="ivr_menu_uid" type="VARCHAR(64)"/>
            <column name="current_node_id" type="VARCHAR(128)"/>
            <column name="next_node_id" type="VARCHAR(128)"/>
            <column name="digits" type="VARCHAR(64)"/>
            <column name="prompts" type="TEXT"/>
            <column name="ivr_status" type="VARCHAR(64)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>