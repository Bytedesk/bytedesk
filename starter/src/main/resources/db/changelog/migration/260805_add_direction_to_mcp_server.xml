<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260805-add-direction-to-mcp-server" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_ai_mcp_server" />
            <not>
                <columnExists tableName="bytedesk_ai_mcp_server" columnName="direction" />
            </not>
        </preConditions>

        <addColumn tableName="bytedesk_ai_mcp_server">
            <column name="direction" type="VARCHAR(32)" defaultValue="SERVER">
                <constraints nullable="false" />
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>