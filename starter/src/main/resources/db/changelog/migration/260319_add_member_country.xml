<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260319-add-member-country" author="githubcopilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_team_member"/>
            <not>
                <columnExists tableName="bytedesk_team_member" columnName="country"/>
            </not>
        </preConditions>

        <addColumn tableName="bytedesk_team_member">
            <column name="country" type="varchar(32)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>