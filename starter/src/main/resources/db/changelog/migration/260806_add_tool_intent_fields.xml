<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260806-add-intent-keywords-to-ai-tool" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_ai_tool" />
            <not>
                <columnExists tableName="bytedesk_ai_tool" columnName="intent_keywords" />
            </not>
        </preConditions>

        <addColumn tableName="bytedesk_ai_tool">
            <column name="intent_keywords" type="TEXT" />
        </addColumn>
    </changeSet>

    <changeSet id="260806-add-intent-match-mode-to-ai-tool" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_ai_tool" />
            <not>
                <columnExists tableName="bytedesk_ai_tool" columnName="intent_match_mode" />
            </not>
        </preConditions>

        <addColumn tableName="bytedesk_ai_tool">
            <column name="intent_match_mode" type="VARCHAR(32)" defaultValue="KEYWORD" />
        </addColumn>
    </changeSet>

    <changeSet id="260806-add-intent-recognition-enabled-to-robot-tools-settings" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_ai_robot_tools_settings" />
            <not>
                <columnExists tableName="bytedesk_ai_robot_tools_settings" columnName="intent_recognition_enabled" />
            </not>
        </preConditions>

        <addColumn tableName="bytedesk_ai_robot_tools_settings">
            <column name="intent_recognition_enabled" type="BOOLEAN" defaultValueBoolean="false" />
        </addColumn>
    </changeSet>

</databaseChangeLog>