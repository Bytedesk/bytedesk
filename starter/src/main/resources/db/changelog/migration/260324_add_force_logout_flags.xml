<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260324-01-add-member-force-logout-columns" author="copilot">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_team_member"/>
                <not>
                    <columnExists tableName="bytedesk_team_member" columnName="force_logout"/>
                </not>
                <not>
                    <columnExists tableName="bytedesk_team_member" columnName="force_logout_reason"/>
                </not>
                <not>
                    <columnExists tableName="bytedesk_team_member" columnName="force_logout_at"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="bytedesk_team_member">
            <column name="force_logout" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="force_logout_reason" type="VARCHAR(512)"/>
            <column name="force_logout_at" type="TIMESTAMP"/>
        </addColumn>
    </changeSet>

    <changeSet id="260324-02-add-agent-force-logout-columns" author="copilot">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_service_agent"/>
                <not>
                    <columnExists tableName="bytedesk_service_agent" columnName="force_logout"/>
                </not>
                <not>
                    <columnExists tableName="bytedesk_service_agent" columnName="force_logout_reason"/>
                </not>
                <not>
                    <columnExists tableName="bytedesk_service_agent" columnName="force_logout_at"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="bytedesk_service_agent">
            <column name="force_logout" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="force_logout_reason" type="VARCHAR(512)"/>
            <column name="force_logout_at" type="TIMESTAMP"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>