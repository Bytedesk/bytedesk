            <tableExists tableName="bytedesk_service_queue_member" />
            <not>
                <indexExists tableName="bytedesk_service_queue_member" indexName="idx_qm_org_agent_deleted_created" />
            </not>
        </preConditions>

        <createIndex tableName="bytedesk_service_queue_member" indexName="idx_qm_org_agent_deleted_created">
