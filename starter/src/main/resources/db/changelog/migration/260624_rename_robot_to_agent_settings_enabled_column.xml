<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260624-rename-robot-to-agent-settings-enabled-column" author="githubcopilot">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_service_robot_to_agent_settings" />
                <columnExists tableName="bytedesk_service_robot_to_agent_settings" columnName="enabled" />
                <not>
                    <columnExists tableName="bytedesk_service_robot_to_agent_settings" columnName="is_enabled" />
                </not>
            </and>
        </preConditions>

        <renameColumn
            tableName="bytedesk_service_robot_to_agent_settings"
            oldColumnName="enabled"
            newColumnName="is_enabled"
            columnDataType="boolean" />
    </changeSet>

</databaseChangeLog>
