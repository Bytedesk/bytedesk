<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260713-add-voicemail-hotline-fields" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_call_voicemail"/>
            <not>
                <columnExists tableName="bytedesk_call_voicemail" columnName="call_uuid"/>
            </not>
        </preConditions>

        <addColumn tableName="bytedesk_call_voicemail">
            <column name="call_uuid" type="VARCHAR(64)"/>
            <column name="caller_id_number" type="VARCHAR(64)"/>
            <column name="destination_number" type="VARCHAR(64)"/>
            <column name="did_number" type="VARCHAR(64)"/>
            <column name="ivr_menu_uid" type="VARCHAR(64)"/>
            <column name="workflow_uid" type="VARCHAR(64)"/>
            <column name="queue_uid" type="VARCHAR(64)"/>
            <column name="leave_reason" type="VARCHAR(64)"/>
            <column name="recording_url" type="VARCHAR(1024)"/>
            <column name="transcription_text" type="TEXT"/>
            <column name="callback_status" type="VARCHAR(64)"/>
            <column name="callback_agent_uid" type="VARCHAR(64)"/>
            <column name="related_ivr_record_uid" type="VARCHAR(64)"/>
            <column name="handled_at" type="TIMESTAMP"/>
        </addColumn>

        <createIndex tableName="bytedesk_call_voicemail" indexName="idx_call_voicemail_call_uuid">
            <column name="call_uuid"/>
        </createIndex>
        <createIndex tableName="bytedesk_call_voicemail" indexName="idx_call_voicemail_callback_status">
            <column name="callback_status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>