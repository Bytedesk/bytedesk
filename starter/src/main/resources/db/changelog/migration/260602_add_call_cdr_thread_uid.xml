<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260602-add-call-cdr-thread-uid" author="copilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_call_cdr"/>
            <not>
                <columnExists tableName="bytedesk_call_cdr" columnName="thread_uid"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_call_cdr">
            <column name="thread_uid" type="varchar(64)"/>
        </addColumn>
    </changeSet>

    <changeSet id="260602-add-call-cdr-thread-uid-index" author="copilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_call_cdr"/>
            <columnExists tableName="bytedesk_call_cdr" columnName="thread_uid"/>
            <not>
                <indexExists tableName="bytedesk_call_cdr" indexName="idx_call_cdr_thread_uid"/>
            </not>
        </preConditions>
        <createIndex tableName="bytedesk_call_cdr" indexName="idx_call_cdr_thread_uid">
            <column name="thread_uid"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>