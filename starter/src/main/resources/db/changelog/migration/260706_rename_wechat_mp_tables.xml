<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260706-rename-wechat-mp-push-table" author="copilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_wechat_mp_push"/>
            <not>
                <tableExists tableName="bytedesk_channel_wechat_mp_push"/>
            </not>
        </preConditions>
        <renameTable oldTableName="bytedesk_wechat_mp_push"
                     newTableName="bytedesk_channel_wechat_mp_push"/>
    </changeSet>

    <changeSet id="260706-rename-wechat-mp-subscribe-table" author="copilot">
