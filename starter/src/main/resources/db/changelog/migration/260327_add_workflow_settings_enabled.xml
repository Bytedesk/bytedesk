<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260327-add-workflow-settings-enabled" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <tableExists tableName="bytedesk_core_workflow_settings" />
            <not>
                <columnExists tableName="bytedesk_core_workflow_settings" columnName="is_enabled" />
            </not>
        </preConditions>
        <comment>Add enabled flag to workflow settings</comment>
        <addColumn tableName="bytedesk_core_workflow_settings">
            <column name="is_enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false" />
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="bytedesk_core_workflow_settings" columnName="is_enabled" />
        </rollback>
    </changeSet>

</databaseChangeLog>