<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260323-add-destination-country" author="githubcopilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_destination"/>
            <not>
                <columnExists tableName="bytedesk_call_destination" columnName="country"/>
            </not>
        </preConditions>

        <addColumn tableName="bytedesk_call_destination">
            <column name="country" type="varchar(32)" defaultValue="86"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>