<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260509-add-goods-type-column" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_core_goods"/>
            <not>
                <columnExists tableName="bytedesk_core_goods" columnName="type"/>
            </not>
        </preConditions>

        <addColumn tableName="bytedesk_core_goods">
            <column name="type" type="VARCHAR(64)" defaultValue="GOODS">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="260509-backfill-goods-type" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_core_goods"/>
            <columnExists tableName="bytedesk_core_goods" columnName="type"/>
        </preConditions>

        <sql>
            UPDATE bytedesk_core_goods
            SET type = 'GOODS'
            WHERE type IS NULL OR TRIM(type) = '';
        </sql>
    </changeSet>

    <changeSet id="260509-add-order-type-column" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_core_order"/>
            <not>
                <columnExists tableName="bytedesk_core_order" columnName="type"/>
            </not>
        </preConditions>

        <addColumn tableName="bytedesk_core_order">
            <column name="type" type="VARCHAR(64)" defaultValue="ORDER">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="260509-backfill-order-type" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_core_order"/>
            <columnExists tableName="bytedesk_core_order" columnName="type"/>
        </preConditions>

        <sql>
            UPDATE bytedesk_core_order
            SET type = 'ORDER'
            WHERE type IS NULL OR TRIM(type) = '';
        </sql>
    </changeSet>

</databaseChangeLog>