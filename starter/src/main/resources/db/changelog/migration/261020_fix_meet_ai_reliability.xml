<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="261020-meet-ready-revisions" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="bytedesk_meet_transcript" columnName="ready_revisions"/></not>
        </preConditions>
        <addColumn tableName="bytedesk_meet_transcript">
            <column name="ready_revisions" type="varchar(4000)"/>
        </addColumn>
    </changeSet>
    <changeSet id="261020-meet-model-uid" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="bytedesk_meet_minutes" columnName="model_uid"/></not>
        </preConditions>
        <addColumn tableName="bytedesk_meet_minutes">
            <column name="model_uid" type="varchar(64)"/>
        </addColumn>
    </changeSet>
    <changeSet id="261020-meet-summary-checkpoint" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="bytedesk_meet_minutes" columnName="summary_checkpoint"/></not>
        </preConditions>
        <addColumn tableName="bytedesk_meet_minutes">
            <column name="summary_checkpoint" type="clob"/>
        </addColumn>
    </changeSet>
    <changeSet id="261020-meet-model-request-pending" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="bytedesk_meet_minutes" columnName="model_request_pending"/></not>
        </preConditions>
        <addColumn tableName="bytedesk_meet_minutes">
            <column name="model_request_pending" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
    <changeSet id="261020-meet-legacy-inflight" author="copilot">
        <update tableName="bytedesk_meet_minutes">
            <column name="status" value="NEEDS_REVIEW"/>
            <column name="error_code" value="LEGACY_OUTCOME_UNKNOWN"/>
            <column name="lease_token" valueComputed="NULL"/>
            <where>status = 'RUNNING'</where>
        </update>
        <update tableName="bytedesk_meet_transcript">
            <column name="status" value="NEEDS_REVIEW"/>
            <column name="error_code" value="LEGACY_OUTCOME_UNKNOWN"/>
            <column name="lease_token" valueComputed="NULL"/>
            <where>status = 'RUNNING'</where>
        </update>
    </changeSet>
    <!-- Existing duplicate data must be reconciled explicitly; never silently delete paid results. -->
    <changeSet id="261020-meet-unique-recording" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not><uniqueConstraintExists tableName="bytedesk_meet_transcript" constraintName="uk_meet_recording"/></not>
        </preConditions>
        <addUniqueConstraint tableName="bytedesk_meet_transcript" columnNames="org_uid,recording_uid"
            constraintName="uk_meet_recording"/>
    </changeSet>
    <changeSet id="261020-meet-unique-segment" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not><uniqueConstraintExists tableName="bytedesk_meet_transcript_seg" constraintName="uk_meet_segment"/></not>
        </preConditions>
        <addUniqueConstraint tableName="bytedesk_meet_transcript_seg" columnNames="transcript_uid,transcript_revision,seq"
            constraintName="uk_meet_segment"/>
    </changeSet>
    <changeSet id="261020-meet-unique-source" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not><uniqueConstraintExists tableName="bytedesk_meet_minutes_source" constraintName="uk_meet_source"/></not>
        </preConditions>
        <addUniqueConstraint tableName="bytedesk_meet_minutes_source" columnNames="minutes_uid,ordinal"
            constraintName="uk_meet_source"/>
    </changeSet>
    <changeSet id="261020-meet-unique-request" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not><uniqueConstraintExists tableName="bytedesk_meet_minutes" constraintName="uk_meet_request"/></not>
        </preConditions>
        <addUniqueConstraint tableName="bytedesk_meet_minutes" columnNames="org_uid,request_key"
            constraintName="uk_meet_request"/>
    </changeSet>
    <changeSet id="261020-meet-large-material" author="copilot">
        <modifyDataType tableName="bytedesk_meet_transcript" columnName="chunk_manifest" newDataType="clob"/>
        <modifyDataType tableName="bytedesk_meet_minutes" columnName="summary" newDataType="clob"/>
        <modifyDataType tableName="bytedesk_meet_minutes" columnName="content_markdown" newDataType="clob"/>
        <modifyDataType tableName="bytedesk_meet_minutes" columnName="structured_result" newDataType="clob"/>
    </changeSet>
</databaseChangeLog>
