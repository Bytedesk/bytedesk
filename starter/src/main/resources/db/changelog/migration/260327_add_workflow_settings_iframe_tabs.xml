<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260327-add-workflow-settings-iframe-tabs" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <tableExists tableName="bytedesk_core_workflow_settings" />
            <not>
                <columnExists tableName="bytedesk_core_workflow_settings" columnName="iframe_tabs" />
            </not>
        </preConditions>
        <comment>Add iframe tabs json to workflow settings</comment>
        <addColumn tableName="bytedesk_core_workflow_settings">
            <column name="iframe_tabs" type="TEXT" />
        </addColumn>
        <rollback>
            <dropColumn tableName="bytedesk_core_workflow_settings" columnName="iframe_tabs" />
        </rollback>
    </changeSet>

</databaseChangeLog>