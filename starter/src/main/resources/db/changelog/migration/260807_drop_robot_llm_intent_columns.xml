<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260807-drop-robot-llm-intent-columns" author="copilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_ai_robot"/>
            <columnExists tableName="bytedesk_ai_robot" columnName="llm_intent_provider"/>
            <columnExists tableName="bytedesk_ai_robot" columnName="llm_intent_model"/>
        </preConditions>
        <comment>
            移除 bytedesk_ai_robot 表中冗余的意图识别字段 llm_intent_provider 和 llm_intent_model。
            意图识别设置已统一迁移至 bytedesk_ai_robot_tools_settings 表（RobotToolsSettingsEntity），
            由 TabTools 面板统一管理 providerUid、model、enabled、timeoutMs 等完整配置。
        </comment>
        <dropColumn tableName="bytedesk_ai_robot" columnName="llm_intent_provider" />
        <dropColumn tableName="bytedesk_ai_robot" columnName="llm_intent_model" />
    </changeSet>

</databaseChangeLog>
