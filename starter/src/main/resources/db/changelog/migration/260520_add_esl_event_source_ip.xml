<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260520-add-esl-event-source-ip" author="githubcopilot">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_call_esl_event" />
                <not>
                    <columnExists tableName="bytedesk_call_esl_event" columnName="source_ip" />
                </not>
            </and>
        </preConditions>

        <addColumn tableName="bytedesk_call_esl_event">
            <column name="source_ip" type="varchar(255)" />
        </addColumn>
    </changeSet>

</databaseChangeLog>