<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        open_airline 演示模块表结构（enterprise/ai）：
        - bytedesk_airline_thread：会话线程（自然主键 thread_uid）
        - bytedesk_airline_snapshot：会话状态快照（自然主键 thread_uid）
        - bytedesk_airline_user_trip：用户演示航程档案（自然主键 user_uid）
        - bytedesk_airline_trace_run：轨迹轮次（自然主键 run_uid）
        - bytedesk_airline_trace_event：追加式轨迹事件（自然主键 event_uid）
        跨库兼容：仅使用标准 createTable/createIndex 标签；大文本统一使用 clob；
        时间戳/版本/序号统一 BIGINT 与实体注解对齐。

        与 ddl-auto=update 的关系（参照仓库既有惯例）：
        - 全新安装：Liquibase 先于 JPA 建表，随后 Hibernate 比对实体，一致则零 ALTER。
        - 升级路径：preConditions/tableExists 保证幂等；已被 ddl-auto 建过的环境跳过。
    -->

    <changeSet id="261123-10-create-airline-thread-table" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="bytedesk_airline_thread"/>
            </not>
        </preConditions>
        <createTable tableName="bytedesk_airline_thread">
            <column name="thread_uid" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="user_uid" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="scenario" type="VARCHAR(255)"/>
            <column name="run_status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_airline_thread_user" tableName="bytedesk_airline_thread">
            <column name="user_uid"/>
        </createIndex>
    </changeSet>

    <changeSet id="261123-20-create-airline-snapshot-table" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="bytedesk_airline_snapshot"/>
            </not>
        </preConditions>
        <createTable tableName="bytedesk_airline_snapshot">
            <column name="thread_uid" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="state_data" type="clob">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="261123-30-create-airline-user-trip-table" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="bytedesk_airline_user_trip"/>
            </not>
        </preConditions>
        <createTable tableName="bytedesk_airline_user_trip">
            <column name="user_uid" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="passenger_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="trip_templates" type="clob">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="261123-40-create-airline-trace-run-table" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="bytedesk_airline_trace_run"/>
            </not>
        </preConditions>
        <createTable tableName="bytedesk_airline_trace_run">
            <column name="run_uid" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="thread_uid" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="owner_uid" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="kind" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="request_id" type="VARCHAR(80)"/>
            <column name="user_message" type="clob"/>
            <column name="started_at" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="ended_at" type="BIGINT"/>
            <column name="run_status" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="integrity" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="integrity_note" type="VARCHAR(500)"/>
            <column name="event_clock" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_airline_trace_run_thread" tableName="bytedesk_airline_trace_run">
            <column name="thread_uid"/>
            <column name="started_at"/>
            <column name="run_uid"/>
        </createIndex>
    </changeSet>

    <changeSet id="261123-50-create-airline-trace-event-table" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="bytedesk_airline_trace_event"/>
            </not>
        </preConditions>
        <createTable tableName="bytedesk_airline_trace_event">
            <column name="event_uid" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="run_uid" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="thread_uid" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="seq" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="activity_uid" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="parent_activity_uid" type="VARCHAR(64)"/>
            <column name="type" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="phase" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="agent_id" type="VARCHAR(32)"/>
            <column name="step" type="INT"/>
            <column name="attempt" type="INT"/>
            <column name="tool_call_id" type="VARCHAR(128)"/>
            <column name="occurred_at" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="duration_ms" type="BIGINT"/>
            <column name="summary" type="VARCHAR(300)"/>
            <column name="payload" type="clob">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_airline_trace_event_run_seq" tableName="bytedesk_airline_trace_event">
            <column name="run_uid"/>
            <column name="seq"/>
        </createIndex>
        <createIndex indexName="idx_airline_trace_event_thread" tableName="bytedesk_airline_trace_event">
            <column name="thread_uid"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
