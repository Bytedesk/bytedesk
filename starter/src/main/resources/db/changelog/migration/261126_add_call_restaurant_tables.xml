    <!--
        修复：BaseEntity 主键为 @GeneratedValue(IDENTITY)，而上方建表语句的 id 列未声明自增，
        导致 PostgreSQL 插入时报 "null value in column \"id\" violates not-null constraint"。
        使用 Liquibase 标签 addAutoIncrement，由各数据库方言生成对应 DDL：
        - mysql/mariadb：AUTO_INCREMENT
        - postgresql/kingbase：IDENTITY / SEQUENCE（按方言）
        - h2：IDENTITY
        - oracle：IDENTITY 或 SEQUENCE+TRIGGER（按方言）
        每张表独立 changeset，避免中途失败导致半修复状态；
        preConditions 仅校验表与列存在，表尚未创建的环境（如 ddl-auto=update 已建表）可安全跳过。
    -->

    <changeSet id="261126-101-fix-call_restaurant-id-autoincrement-store" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_restaurant"/>
            <columnExists tableName="bytedesk_call_restaurant" columnName="id"/>
        </preConditions>
        <addAutoIncrement tableName="bytedesk_call_restaurant" columnName="id" columnDataType="java.sql.Types.BIGINT"/>
    </changeSet>

