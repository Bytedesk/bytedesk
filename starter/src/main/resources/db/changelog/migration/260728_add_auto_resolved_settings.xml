<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet author="jackning" id="260728_create_auto_resolved_settings_table">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="bytedesk_kbase_auto_resolved_settings"/>
            </not>
        </preConditions>
        <createTable tableName="bytedesk_kbase_auto_resolved_settings">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_bytedesk_kbase_auto_resolved_settings" nullable="false"/>
            </column>
            <column name="uuid" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="uid" type="VARCHAR(64)"/>
            <column name="org_uid" type="VARCHAR(64)"/>
            <column name="user_uid" type="VARCHAR(64)"/>
            <column name="nickname" type="VARCHAR(255)"/>
            <column name="avatar" type="VARCHAR(255)"/>
            <column name="real_name" type="VARCHAR(255)"/>
            <column name="mobile" type="VARCHAR(64)"/>
            <column name="email" type="VARCHAR(128)"/>
            <column name="description" type="VARCHAR(512)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="version" type="BIGINT"/>
            <column name="is_enabled" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="timeout_hours" type="INT" defaultValueNumeric="24"/>
            <column name="notify_visitor_on_auto_resolved" type="BOOLEAN" defaultValueBoolean="false"/>
        </createTable>
        <addUniqueConstraint tableName="bytedesk_kbase_auto_resolved_settings" columnNames="uuid" constraintName="uk_kbase_auto_resolved_settings_uuid"/>
    </changeSet>

    <changeSet author="jackning" id="260728_add_agent_auto_resolved_settings_columns">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_service_agent_settings"/>
                <not>
                    <columnExists tableName="bytedesk_service_agent_settings" columnName="auto_resolved_settings_id"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="bytedesk_service_agent_settings">
            <column name="auto_resolved_settings_id" type="BIGINT"/>
            <column name="draft_auto_resolved_settings_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <changeSet author="jackning" id="260728_add_workgroup_auto_resolved_settings_columns">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_service_workgroup_settings"/>
                <not>
                    <columnExists tableName="bytedesk_service_workgroup_settings" columnName="auto_resolved_settings_id"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="bytedesk_service_workgroup_settings">
            <column name="auto_resolved_settings_id" type="BIGINT"/>
            <column name="draft_auto_resolved_settings_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <changeSet author="jackning" id="260728_add_robot_auto_resolved_settings_columns">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_ai_robot_settings"/>
                <not>
                    <columnExists tableName="bytedesk_ai_robot_settings" columnName="auto_resolved_settings_id"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="bytedesk_ai_robot_settings">
            <column name="auto_resolved_settings_id" type="BIGINT"/>
            <column name="draft_auto_resolved_settings_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <changeSet author="jackning" id="260728_add_auto_resolved_settings_foreign_keys">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_kbase_auto_resolved_settings"/>
                <columnExists tableName="bytedesk_service_agent_settings" columnName="auto_resolved_settings_id"/>
                <columnExists tableName="bytedesk_service_workgroup_settings" columnName="auto_resolved_settings_id"/>
                <columnExists tableName="bytedesk_ai_robot_settings" columnName="auto_resolved_settings_id"/>
            </and>
        </preConditions>
        <addForeignKeyConstraint
            baseTableName="bytedesk_service_agent_settings"
            baseColumnNames="auto_resolved_settings_id"
            constraintName="fk_agent_settings_auto_resolved_settings"
            referencedTableName="bytedesk_kbase_auto_resolved_settings"
            referencedColumnNames="id"/>
        <addForeignKeyConstraint
            baseTableName="bytedesk_service_agent_settings"
            baseColumnNames="draft_auto_resolved_settings_id"
            constraintName="fk_agent_settings_draft_auto_resolved_settings"
            referencedTableName="bytedesk_kbase_auto_resolved_settings"
            referencedColumnNames="id"/>
        <addForeignKeyConstraint
            baseTableName="bytedesk_service_workgroup_settings"
            baseColumnNames="auto_resolved_settings_id"
            constraintName="fk_workgroup_settings_auto_resolved_settings"
            referencedTableName="bytedesk_kbase_auto_resolved_settings"
            referencedColumnNames="id"/>
        <addForeignKeyConstraint
            baseTableName="bytedesk_service_workgroup_settings"
            baseColumnNames="draft_auto_resolved_settings_id"
            constraintName="fk_workgroup_settings_draft_auto_resolved_settings"
            referencedTableName="bytedesk_kbase_auto_resolved_settings"
            referencedColumnNames="id"/>
        <addForeignKeyConstraint
            baseTableName="bytedesk_ai_robot_settings"
            baseColumnNames="auto_resolved_settings_id"
            constraintName="fk_robot_settings_auto_resolved_settings"
            referencedTableName="bytedesk_kbase_auto_resolved_settings"
            referencedColumnNames="id"/>
        <addForeignKeyConstraint
            baseTableName="bytedesk_ai_robot_settings"
            baseColumnNames="draft_auto_resolved_settings_id"
            constraintName="fk_robot_settings_draft_auto_resolved_settings"
            referencedTableName="bytedesk_kbase_auto_resolved_settings"
            referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>