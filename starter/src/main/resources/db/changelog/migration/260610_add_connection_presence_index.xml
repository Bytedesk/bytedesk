<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260610-add-connection-user-status-deleted-index" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_core_connection"/>
            <columnExists tableName="bytedesk_core_connection" columnName="user_uid"/>
            <columnExists tableName="bytedesk_core_connection" columnName="status"/>
            <columnExists tableName="bytedesk_core_connection" columnName="is_deleted"/>
            <not>
                <indexExists tableName="bytedesk_core_connection" indexName="idx_core_conn_user_status_deleted"/>
            </not>
        </preConditions>

        <createIndex tableName="bytedesk_core_connection" indexName="idx_core_conn_user_status_deleted">
            <column name="user_uid"/>
            <column name="status"/>
            <column name="is_deleted"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>