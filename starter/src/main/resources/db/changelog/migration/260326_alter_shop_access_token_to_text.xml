<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260326-alter-shop-access-token-to-text" author="copilot">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <and>
                <tableExists tableName="bytedesk_core_shop"/>
                <columnExists tableName="bytedesk_core_shop" columnName="access_token"/>
            </and>
        </preConditions>
        <modifyDataType tableName="bytedesk_core_shop" columnName="access_token" newDataType="TEXT"/>
        <rollback>
            <modifyDataType tableName="bytedesk_core_shop" columnName="access_token" newDataType="VARCHAR(1024)"/>
        </rollback>
    </changeSet>

</databaseChangeLog>