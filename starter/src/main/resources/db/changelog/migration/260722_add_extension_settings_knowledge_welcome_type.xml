<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260722-add-extension-settings-knowledge-welcome-type" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_call_extension_settings_knowledge" />
            <not>
                <columnExists tableName="bytedesk_call_extension_settings_knowledge" columnName="welcome_type" />
            </not>
        </preConditions>

        <addColumn tableName="bytedesk_call_extension_settings_knowledge">
            <column name="welcome_type" type="varchar(32)" defaultValue="TTS" />
        </addColumn>

        <update tableName="bytedesk_call_extension_settings_knowledge">
            <column name="welcome_type" value="TTS" />
            <where>welcome_type IS NULL</where>
        </update>
    </changeSet>

</databaseChangeLog>