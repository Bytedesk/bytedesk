<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260604-add-ring-group-extension-number" author="githubcopilot">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_call_ring_group" />
                <not>
                    <columnExists tableName="bytedesk_call_ring_group" columnName="extension_number" />
                </not>
            </and>
        </preConditions>

        <addColumn tableName="bytedesk_call_ring_group">
            <column name="extension_number" type="varchar(64)" />
        </addColumn>
    </changeSet>

