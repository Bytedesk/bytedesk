<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260323-01-add-destination-number" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_destination"/>
            <not>
                <columnExists tableName="bytedesk_call_destination" columnName="phone_number"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_call_destination">
            <column name="phone_number" type="varchar(64)"/>
        </addColumn>
    </changeSet>

    <changeSet id="260323-02-add-destination-status" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_destination"/>
            <not>
                <columnExists tableName="bytedesk_call_destination" columnName="destination_status"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_call_destination">
            <column name="destination_status" type="varchar(64)" defaultValue="ACTIVE"/>
        </addColumn>
    </changeSet>

    <changeSet id="260323-03-add-destination-location" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_destination"/>
            <not>
                <columnExists tableName="bytedesk_call_destination" columnName="number_location"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_call_destination">
            <column name="number_location" type="varchar(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="260323-04-add-destination-tag-list" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_destination"/>
            <not>
                <columnExists tableName="bytedesk_call_destination" columnName="tag_list"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_call_destination">
            <column name="tag_list" type="TEXT"/>
        </addColumn>
    </changeSet>

    <changeSet id="260323-05-drop-destination-name" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_destination"/>
            <columnExists tableName="bytedesk_call_destination" columnName="name"/>
        </preConditions>
        <dropColumn tableName="bytedesk_call_destination" columnName="name"/>
    </changeSet>

</databaseChangeLog>