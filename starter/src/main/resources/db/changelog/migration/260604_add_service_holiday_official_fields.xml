    <changeSet id="260604-add-service-holiday-official-fields" author="githubcopilot">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_service_holiday"/>
            <not>
                <or>
                    <columnExists tableName="bytedesk_service_holiday" columnName="holiday_date"/>
                    <columnExists tableName="bytedesk_service_holiday" columnName="holiday_year"/>
                    <columnExists tableName="bytedesk_service_holiday" columnName="country_code"/>
                    <columnExists tableName="bytedesk_service_holiday" columnName="is_off_day"/>
                    <columnExists tableName="bytedesk_service_holiday" columnName="is_official"/>
                    <columnExists tableName="bytedesk_service_holiday" columnName="source_url"/>
                    <columnExists tableName="bytedesk_service_holiday" columnName="holiday_key"/>
                </or>
            </not>
        </preConditions>

        <addColumn tableName="bytedesk_service_holiday">
            <column name="holiday_date" type="DATE"/>
            <column name="holiday_year" type="INT" defaultValueNumeric="2026"/>
            <column name="country_code" type="VARCHAR(16)" defaultValue="CN"/>
            <column name="is_off_day" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="is_official" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="source_url" type="VARCHAR(512)"/>
            <column name="holiday_key" type="VARCHAR(128)"/>
        </addColumn>

        <createIndex tableName="bytedesk_service_holiday" indexName="idx_service_holiday_country_date">
            <column name="country_code"/>
            <column name="holiday_date"/>
        </createIndex>
    </changeSet>

