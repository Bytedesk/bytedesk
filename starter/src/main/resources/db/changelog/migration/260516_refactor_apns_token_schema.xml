<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260516-refactor-apns-token-add-device-token" author="githubcopilot">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_core_apns_token"/>
            <not>
                <columnExists tableName="bytedesk_core_apns_token" columnName="device_token"/>
            </not>
        </preConditions>

        <addColumn tableName="bytedesk_core_apns_token">
            <column name="device_token" type="VARCHAR(512)"/>
        </addColumn>

        <update tableName="bytedesk_core_apns_token">
            <column name="device_token" valueComputed="uuid"/>
            <where>device_token IS NULL</where>
        </update>

        <dropNotNullConstraint tableName="bytedesk_core_apns_token" columnName="device_token" columnDataType="VARCHAR(512)"/>
        <addNotNullConstraint tableName="bytedesk_core_apns_token" columnName="device_token" columnDataType="VARCHAR(512)"/>

    </changeSet>

    <changeSet id="260516-refactor-apns-token-drop-name" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_core_apns_token"/>
            <columnExists tableName="bytedesk_core_apns_token" columnName="name"/>
        </preConditions>
        <dropColumn tableName="bytedesk_core_apns_token" columnName="name"/>
    </changeSet>

    <changeSet id="260516-refactor-apns-token-drop-description" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_core_apns_token"/>
            <columnExists tableName="bytedesk_core_apns_token" columnName="description"/>
        </preConditions>
        <dropColumn tableName="bytedesk_core_apns_token" columnName="description"/>
    </changeSet>

</databaseChangeLog>
