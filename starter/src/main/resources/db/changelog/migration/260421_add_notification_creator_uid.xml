<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260421-add-notification-creator-uid" author="githubcopilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_core_notification"/>
            <not>
                <columnExists tableName="bytedesk_core_notification" columnName="creator_uid"/>
            </not>
        </preConditions>

        <addColumn tableName="bytedesk_core_notification">
            <column name="creator_uid" type="varchar(255)"/>
        </addColumn>

        <rollback>
            <dropColumn tableName="bytedesk_core_notification" columnName="creator_uid"/>
        </rollback>
    </changeSet>

</databaseChangeLog>