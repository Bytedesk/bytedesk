<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260604-add-call-route-time-condition-uid" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_call_route"/>
        </preConditions>

        <addColumn tableName="bytedesk_call_route">
            <column name="time_condition_uid" type="VARCHAR(64)"/>
        </addColumn>

        <createIndex tableName="bytedesk_call_route" indexName="idx_call_route_time_condition_uid">
            <column name="time_condition_uid"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>