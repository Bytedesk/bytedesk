<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        为 bytedesk_kbase_service_settings 新增访客关闭提示语字段。
        - visitor_close_tip: 访客主动关闭会话时下发的提示语，默认 'i18n.visitor.close.tip'。
        背景：访客关闭会话此前复用 agent_close_tip，现拆分为独立消息类型 VISITOR_CLOSED
        与独立提示语，便于区分"客服关闭"与"访客关闭"。
        与 auto_close_tip / agent_close_tip 同为普通 VARCHAR 列。
    -->
    <changeSet id="260811-4-add-service-settings-visitor-close-tip" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_kbase_service_settings"/>
            <not>
                <columnExists tableName="bytedesk_kbase_service_settings" columnName="visitor_close_tip"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_kbase_service_settings">
            <column name="visitor_close_tip" type="VARCHAR(255)" defaultValue="i18n.visitor.close.tip">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!--
        回填历史数据：将 visitor_close_tip 为 NULL 的记录设置为默认提示语 i18n key。
        MySQL ADD COLUMN 带 defaultValue 会对已有行实际填充默认值，但为兼容其它数据库
        （如 PostgreSQL/H2 ADD COLUMN 未必回填）以及防止 NULL，统一回填一次。幂等。
    -->
    <changeSet id="260811-5-backfill-service-settings-visitor-close-tip" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_kbase_service_settings"/>
            <columnExists tableName="bytedesk_kbase_service_settings" columnName="visitor_close_tip"/>
        </preConditions>
        <update tableName="bytedesk_kbase_service_settings">
            <column name="visitor_close_tip" value="i18n.visitor.close.tip"/>
            <where>visitor_close_tip IS NULL</where>
        </update>
    </changeSet>

</databaseChangeLog>
