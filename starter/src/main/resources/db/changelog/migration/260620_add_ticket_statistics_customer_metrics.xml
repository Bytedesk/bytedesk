    <changeSet id="260620-add-ticket-statistics-ticket-type-index-mysql" author="githubcopilot" dbms="mysql">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_ticket_statistics"/>
            <columnExists tableName="bytedesk_ticket_statistics" columnName="org_uid"/>
            <columnExists tableName="bytedesk_ticket_statistics" columnName="ticket_type"/>
            <columnExists tableName="bytedesk_ticket_statistics" columnName="statistic_type"/>
            <columnExists tableName="bytedesk_ticket_statistics" columnName="date"/>
            <not>
                <indexExists tableName="bytedesk_ticket_statistics" indexName="idx_ticket_stats_org_ticket_type_date"/>
            </not>
        </preConditions>

        <sql><![CDATA[
            ALTER TABLE `bytedesk_ticket_statistics`
            ADD INDEX `idx_ticket_stats_org_ticket_type_date` (
                `org_uid`(64),
                `ticket_type`(32),
                `statistic_type`(32),
                `date`(16),
                `is_deleted`
            )
        ]]></sql>
    </changeSet>

