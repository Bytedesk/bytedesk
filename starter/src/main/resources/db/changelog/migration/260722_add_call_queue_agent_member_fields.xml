<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- CallQueueAgent columns – one changeset per column for idempotent recovery -->

    <changeSet id="260722-add-call-queue-agent-queue-uid" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_queue_agent"/>
            <not>
                <columnExists tableName="bytedesk_call_queue_agent" columnName="queue_uid"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_call_queue_agent">
            <column name="queue_uid" type="varchar(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="260722-add-call-queue-agent-agent-uid" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_queue_agent"/>
            <not>
                <columnExists tableName="bytedesk_call_queue_agent" columnName="agent_uid"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_call_queue_agent">
            <column name="agent_uid" type="varchar(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="260722-add-call-queue-agent-agent-extension" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_queue_agent"/>
            <not>
                <columnExists tableName="bytedesk_call_queue_agent" columnName="agent_extension"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_call_queue_agent">
            <column name="agent_extension" type="varchar(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="260722-add-call-queue-agent-member-type" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_queue_agent"/>
            <not>
                <columnExists tableName="bytedesk_call_queue_agent" columnName="member_type"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_call_queue_agent">
            <column name="member_type" type="varchar(64)" defaultValue="AGENT"/>
        </addColumn>
    </changeSet>

    <changeSet id="260722-add-call-queue-agent-priority" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_queue_agent"/>
            <not>
                <columnExists tableName="bytedesk_call_queue_agent" columnName="priority"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_call_queue_agent">
            <column name="priority" type="int" defaultValueNumeric="0"/>
        </addColumn>
    </changeSet>

    <changeSet id="260722-add-call-queue-agent-weight" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_queue_agent"/>
            <not>
                <columnExists tableName="bytedesk_call_queue_agent" columnName="weight"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_call_queue_agent">
            <column name="weight" type="int" defaultValueNumeric="1"/>
        </addColumn>
    </changeSet>

    <changeSet id="260722-add-call-queue-agent-skill-tags" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_queue_agent"/>
            <not>
                <columnExists tableName="bytedesk_call_queue_agent" columnName="skill_tags"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_call_queue_agent">
            <column name="skill_tags" type="varchar(1024)"/>
        </addColumn>
    </changeSet>

    <changeSet id="260722-add-call-queue-agent-max-concurrent" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_queue_agent"/>
            <not>
                <columnExists tableName="bytedesk_call_queue_agent" columnName="max_concurrent_calls"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_call_queue_agent">
            <column name="max_concurrent_calls" type="int" defaultValueNumeric="1"/>
        </addColumn>
    </changeSet>

    <changeSet id="260722-add-call-queue-agent-active-call-count" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_queue_agent"/>
            <not>
                <columnExists tableName="bytedesk_call_queue_agent" columnName="active_call_count"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_call_queue_agent">
            <column name="active_call_count" type="int" defaultValueNumeric="0"/>
        </addColumn>
    </changeSet>

    <changeSet id="260722-add-call-queue-agent-is-enabled" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_queue_agent"/>
            <not>
                <columnExists tableName="bytedesk_call_queue_agent" columnName="is_enabled"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_call_queue_agent">
            <column name="is_enabled" type="boolean" defaultValueBoolean="true"/>
        </addColumn>
    </changeSet>

    <changeSet id="260722-add-call-queue-agent-last-assigned-at" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_queue_agent"/>
            <not>
                <columnExists tableName="bytedesk_call_queue_agent" columnName="last_assigned_at"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_call_queue_agent">
            <column name="last_assigned_at" type="datetime"/>
        </addColumn>
    </changeSet>

    <!-- CallQueueAgent indexes – guarded by NOT indexExists -->

    <changeSet id="260722-add-call-queue-agent-indexes" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_queue_agent"/>
            <columnExists tableName="bytedesk_call_queue_agent" columnName="queue_uid"/>
            <columnExists tableName="bytedesk_call_queue_agent" columnName="agent_uid"/>
            <not>
                <indexExists tableName="bytedesk_call_queue_agent" indexName="uk_call_queue_agent_queue_agent"/>
            </not>
        </preConditions>

        <createIndex tableName="bytedesk_call_queue_agent" indexName="uk_call_queue_agent_queue_agent" unique="true">
            <column name="org_uid"/>
            <column name="queue_uid"/>
            <column name="agent_uid"/>
            <column name="is_deleted"/>
        </createIndex>

        <createIndex tableName="bytedesk_call_queue_agent" indexName="idx_call_queue_agent_queue_extension">
            <column name="org_uid"/>
            <column name="queue_uid"/>
            <column name="agent_extension"/>
            <column name="is_enabled"/>
            <column name="is_deleted"/>
        </createIndex>
    </changeSet>

    <!-- AcdQueueEntry queue_uid column -->

    <changeSet id="260722-add-acd-queue-entry-queue-uid" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_acd_queue_entry"/>
            <not>
                <columnExists tableName="bytedesk_call_acd_queue_entry" columnName="queue_uid"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_call_acd_queue_entry">
            <column name="queue_uid" type="varchar(255)"/>
        </addColumn>
    </changeSet>

    <!-- AcdQueueEntry index -->

    <changeSet id="260722-add-acd-queue-entry-index" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_acd_queue_entry"/>
            <columnExists tableName="bytedesk_call_acd_queue_entry" columnName="queue_uid"/>
            <not>
                <indexExists tableName="bytedesk_call_acd_queue_entry" indexName="idx_call_acd_queue_entry_queue_uid"/>
            </not>
        </preConditions>
        <createIndex tableName="bytedesk_call_acd_queue_entry" indexName="idx_call_acd_queue_entry_queue_uid">
            <column name="org_uid"/>
            <column name="queue_uid"/>
            <column name="acd_status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>