<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260616-create-quality-rule-table" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <not>
                <tableExists tableName="bytedesk_service_quality_rule"/>
            </not>
        </preConditions>

        <createTable tableName="bytedesk_service_quality_rule">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_service_quality_rule" nullable="false"/>
            </column>
            <column name="uuid" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_service_quality_rule_uuid"/>
            </column>
            <column name="version" type="INT" defaultValueNumeric="0"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="org_uid" type="VARCHAR(64)"/>
            <column name="user_uid" type="VARCHAR(64)"/>
            <column name="level_type" type="VARCHAR(64)"/>
            <column name="platform_type" type="VARCHAR(64)"/>
            <column name="name" type="VARCHAR(255)"/>
            <column name="description" type="VARCHAR(512)"/>
            <column name="category" type="VARCHAR(128)"/>
            <column name="plan_uid" type="VARCHAR(64)"/>
            <column name="plan_type" type="VARCHAR(64)"/>
            <column name="target" type="VARCHAR(64)"/>
            <column name="scope" type="VARCHAR(64)"/>
            <column name="rule_operator" type="VARCHAR(64)"/>
            <column name="field_path" type="VARCHAR(255)"/>
            <column name="rule_values" type="TEXT"/>
            <column name="condition_json" type="TEXT"/>
            <column name="action_json" type="TEXT"/>
            <column name="priority" type="INT" defaultValueNumeric="0"/>
            <column name="is_enabled" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="rule_version" type="INT" defaultValueNumeric="1"/>
        </createTable>

        <createIndex tableName="bytedesk_service_quality_rule" indexName="idx_quality_rule_org_plan_enabled_deleted">
            <column name="org_uid"/>
            <column name="plan_uid"/>
            <column name="is_enabled"/>
            <column name="is_deleted"/>
        </createIndex>

        <createIndex tableName="bytedesk_service_quality_rule" indexName="idx_quality_rule_org_type_target">
            <column name="org_uid"/>
            <column name="plan_type"/>
            <column name="target"/>
        </createIndex>
    </changeSet>

    <changeSet id="260616-extend-quality-check-rule-fields" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_service_quality_check"/>
        </preConditions>
        <addColumn tableName="bytedesk_service_quality_check">
            <column name="is_auto_check" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="rule_matches" type="TEXT"/>
            <column name="raw_score" type="INT"/>
            <column name="manual_adjusted_score" type="INT"/>
            <column name="is_review_required" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="quality_plan_version" type="INT"/>
            <column name="rule_snapshot" type="TEXT"/>
        </addColumn>
    </changeSet>

    <changeSet id="260616-extend-quality-plan-auto-fields" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_service_quality_plan"/>
        </preConditions>
        <addColumn tableName="bytedesk_service_quality_plan">
            <column name="is_auto_check_enabled" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="base_score" type="INT" defaultValueNumeric="100"/>
            <column name="pass_score" type="INT" defaultValueNumeric="70"/>
            <column name="sampling_strategy" type="VARCHAR(32)"/>
            <column name="sampling_value" type="INT"/>
            <column name="plan_version" type="INT" defaultValueNumeric="1"/>
            <column name="published_at" type="TIMESTAMP"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
