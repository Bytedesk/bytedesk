<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260601-add-call-cdr-transcript-status" author="copilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_call_cdr"/>
            <not>
                <columnExists tableName="bytedesk_call_cdr" columnName="transcript_status"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_call_cdr">
            <column name="transcript_status" type="varchar(32)" defaultValue="PENDING"/>
        </addColumn>
    </changeSet>

    <changeSet id="260601-add-call-cdr-transcript-text" author="copilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_call_cdr"/>
            <not>
                <columnExists tableName="bytedesk_call_cdr" columnName="transcript_text"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_call_cdr">
            <column name="transcript_text" type="TEXT"/>
        </addColumn>
    </changeSet>

    <changeSet id="260601-add-call-cdr-transcript-error-message" author="copilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_call_cdr"/>
            <not>
                <columnExists tableName="bytedesk_call_cdr" columnName="transcript_error_message"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_call_cdr">
            <column name="transcript_error_message" type="TEXT"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>