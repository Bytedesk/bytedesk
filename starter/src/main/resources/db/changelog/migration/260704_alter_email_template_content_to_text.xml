<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260704-alter-email-template-content-to-text" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_core_email_template" />
                <columnExists tableName="bytedesk_core_email_template" columnName="content" />
            </and>
        </preConditions>

        <modifyDataType tableName="bytedesk_core_email_template" columnName="content" newDataType="MEDIUMTEXT" />

        <rollback>
            <modifyDataType tableName="bytedesk_core_email_template" columnName="content" newDataType="TEXT" />
        </rollback>
    </changeSet>

    <changeSet id="260704-alter-email-template-plain-text-to-text" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_core_email_template" />
                <columnExists tableName="bytedesk_core_email_template" columnName="plain_text" />
            </and>
        </preConditions>

        <modifyDataType tableName="bytedesk_core_email_template" columnName="plain_text" newDataType="MEDIUMTEXT" />

        <rollback>
            <modifyDataType tableName="bytedesk_core_email_template" columnName="plain_text" newDataType="TEXT" />
        </rollback>
    </changeSet>

</databaseChangeLog>
