        <createIndex tableName="bytedesk_ai_agent_turn_trace" indexName="idx_ai_turn_trace_org_thread">
            <column name="org_uid" />
            <column name="thread_uid" />
        </createIndex>

        <createIndex tableName="bytedesk_ai_agent_turn_trace" indexName="idx_ai_turn_trace_robot_created">
            <column name="robot_uid" />
            <column name="created_at" />
        </createIndex>

        <createIndex tableName="bytedesk_ai_agent_turn_trace" indexName="idx_ai_turn_trace_message">
            <column name="message_uid" />
        </createIndex>
    </changeSet>

</databaseChangeLog>
