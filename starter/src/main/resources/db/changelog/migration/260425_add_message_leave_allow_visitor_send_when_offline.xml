<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260425-add-message-leave-allow-visitor-send-when-offline" author="github-copilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_service_message_leave_settings" />
            <not>
                <columnExists
                    tableName="bytedesk_service_message_leave_settings"
                    columnName="message_leave_allow_visitor_send_when_offline" />
            </not>
        </preConditions>

        <addColumn tableName="bytedesk_service_message_leave_settings">
            <column
                name="message_leave_allow_visitor_send_when_offline"
                type="boolean"
                defaultValueBoolean="true"
                remarks="Allow visitors to send messages when agent is offline" />
        </addColumn>
    </changeSet>

</databaseChangeLog>
