<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260722-add-cdr-queue-uid" author="githubcopilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_cdr"/>
            <not>
                <columnExists tableName="bytedesk_call_cdr" columnName="queue_uid"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_call_cdr">
            <column name="queue_uid" type="VARCHAR(64)"/>
        </addColumn>
    </changeSet>

    <changeSet id="260722-add-cdr-agent-uid" author="githubcopilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_cdr"/>
            <not>
                <columnExists tableName="bytedesk_call_cdr" columnName="agent_uid"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_call_cdr">
            <column name="agent_uid" type="VARCHAR(64)"/>
        </addColumn>
    </changeSet>

    <changeSet id="260722-add-cdr-indexes" author="githubcopilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_cdr"/>
            <columnExists tableName="bytedesk_call_cdr" columnName="queue_uid"/>
            <columnExists tableName="bytedesk_call_cdr" columnName="agent_uid"/>
            <not>
                <indexExists tableName="bytedesk_call_cdr" indexName="idx_call_cdr_queue_uid"/>
            </not>
        </preConditions>

        <createIndex tableName="bytedesk_call_cdr" indexName="idx_call_cdr_queue_uid">
            <column name="queue_uid"/>
        </createIndex>

        <createIndex tableName="bytedesk_call_cdr" indexName="idx_call_cdr_agent_uid">
            <column name="agent_uid"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>