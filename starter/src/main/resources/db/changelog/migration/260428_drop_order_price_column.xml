<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260428-drop-order-price-column" author="github-copilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_core_order" />
            <columnExists tableName="bytedesk_core_order" columnName="price" />
        </preConditions>

        <dropColumn tableName="bytedesk_core_order" columnName="price" />
    </changeSet>

</databaseChangeLog>