<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260401-add-webrtc-call-direction" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <tableExists tableName="bytedesk_video_webrtc" />
            <not>
                <columnExists tableName="bytedesk_video_webrtc" columnName="call_direction" />
            </not>
        </preConditions>
        <comment>Add call direction to identify inbound and outbound webrtc calls</comment>
        <addColumn tableName="bytedesk_video_webrtc">
            <column name="call_direction" type="VARCHAR(32)" defaultValue="INBOUND">
                <constraints nullable="false" />
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="bytedesk_video_webrtc" columnName="call_direction" />
        </rollback>
    </changeSet>

