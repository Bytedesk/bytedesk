<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260509-add-goods-navigate-to-path-column" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_core_goods"/>
            <not>
                <columnExists tableName="bytedesk_core_goods" columnName="navigate_to_path"/>
            </not>
        </preConditions>

        <addColumn tableName="bytedesk_core_goods">
            <column name="navigate_to_path" type="VARCHAR(512)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="260509-add-order-navigate-to-path-column" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_core_order"/>
            <not>
                <columnExists tableName="bytedesk_core_order" columnName="navigate_to_path"/>
            </not>
        </preConditions>

        <addColumn tableName="bytedesk_core_order">
            <column name="navigate_to_path" type="VARCHAR(512)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>