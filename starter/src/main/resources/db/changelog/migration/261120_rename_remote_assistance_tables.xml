<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="261120-rename-remote-device" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_desktop_device"/>
            <not>
                <tableExists tableName="bytedesk_remote_device"/>
            </not>
        </preConditions>
        <renameTable oldTableName="bytedesk_desktop_device" newTableName="bytedesk_remote_device"/>
    </changeSet>
