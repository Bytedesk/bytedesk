<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260728-create-ticket-assignment-log-table" author="bytedesk">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="bytedesk_ticket_assignment_log"/>
            </not>
        </preConditions>
        <createTable tableName="bytedesk_ticket_assignment_log">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_bytedesk_ticket_assignment_log" nullable="false"/>
            </column>
            <column name="uuid" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="uid" type="VARCHAR(64)"/>
            <column name="org_uid" type="VARCHAR(64)"/>
            <column name="user_uid" type="VARCHAR(64)"/>
            <column name="nickname" type="VARCHAR(255)"/>
            <column name="avatar" type="VARCHAR(255)"/>
            <column name="real_name" type="VARCHAR(255)"/>
            <column name="mobile" type="VARCHAR(64)"/>
            <column name="email" type="VARCHAR(128)"/>
            <column name="description" type="VARCHAR(512)"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="version" type="BIGINT"/>

            <column name="ticket_uid" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="process_instance_id" type="VARCHAR(64)"/>
            <column name="task_definition_key" type="VARCHAR(255)"/>
            <column name="from_assignee" type="TEXT"/>
            <column name="to_assignee" type="TEXT"/>
            <column name="assignment_type" type="VARCHAR(32)"/>
            <column name="strategy" type="VARCHAR(64)"/>
            <column name="reason" type="VARCHAR(512)"/>
            <column name="candidate_pool_description" type="VARCHAR(256)"/>
        </createTable>
        <addUniqueConstraint tableName="bytedesk_ticket_assignment_log" columnNames="uuid" constraintName="uk_ticket_assignment_log_uuid"/>
        <createIndex tableName="bytedesk_ticket_assignment_log" indexName="idx_ticket_assignment_log_ticket_uid">
            <column name="ticket_uid"/>
        </createIndex>
        <createIndex tableName="bytedesk_ticket_assignment_log" indexName="idx_ticket_assignment_log_created_at">
            <column name="created_at"/>
        </createIndex>
        <rollback>
            <dropTable tableName="bytedesk_ticket_assignment_log"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
