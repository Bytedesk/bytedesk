<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260603-add-call-task-transfer-and-ivr-fields" author="githubcopilot">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_call_task" />
                <not>
                    <columnExists tableName="bytedesk_call_task" columnName="transfer_extension_numbers" />
                </not>
            </and>
        </preConditions>
        <addColumn tableName="bytedesk_call_task">
            <column name="post_answer_action" type="varchar(32)" defaultValue="MANUAL_ONLY" />
            <column name="transfer_strategy" type="varchar(32)" defaultValue="SEQUENTIAL" />
            <column name="transfer_extension_numbers" type="varchar(512)" />
            <column name="ivr_menu_uid" type="varchar(64)" />
        </addColumn>
    </changeSet>

</databaseChangeLog>