<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260722-add-extension-settings-routing-time-condition-switch" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_call_extension_settings_routing" />
            <not>
                <columnExists tableName="bytedesk_call_extension_settings_routing" columnName="enable_time_condition_routing" />
            </not>
        </preConditions>

        <addColumn tableName="bytedesk_call_extension_settings_routing">
            <column name="enable_time_condition_routing" type="boolean" defaultValueBoolean="false" />
        </addColumn>

        <update tableName="bytedesk_call_extension_settings_routing">
            <column name="enable_time_condition_routing" valueBoolean="false" />
            <where>enable_time_condition_routing IS NULL</where>
        </update>
    </changeSet>

</databaseChangeLog>