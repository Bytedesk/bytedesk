<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260327-add-workflow-settings-binding" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <tableExists tableName="bytedesk_core_workflow" />
            <not>
                <columnExists tableName="bytedesk_core_workflow" columnName="settings_id" />
            </not>
        </preConditions>
        <comment>Add workflow settings binding column to workflow table</comment>
        <addColumn tableName="bytedesk_core_workflow">
            <column name="settings_id" type="BIGINT" />
        </addColumn>
        <rollback>
            <dropColumn tableName="bytedesk_core_workflow" columnName="settings_id" />
        </rollback>
    </changeSet>

</databaseChangeLog>