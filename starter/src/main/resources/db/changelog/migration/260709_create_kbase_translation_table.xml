<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260709-create-kbase-translation-table" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <not>
                <tableExists tableName="bytedesk_kbase_translation"/>
            </not>
        </preConditions>

        <createTable tableName="bytedesk_kbase_translation">
            <column name="id" type="bigint" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="uuid" type="varchar(255)"><constraints nullable="false" unique="true"/></column>
            <column name="version" type="int" defaultValueNumeric="0"/>
            <column name="created_at" type="datetime"/>
            <column name="updated_at" type="datetime"/>
            <column name="is_deleted" type="boolean" defaultValueBoolean="false"/>
            <column name="org_uid" type="varchar(255)"/>
            <column name="user_uid" type="varchar(255)"/>
            <column name="level_type" type="varchar(255)"/>
            <column name="platform_type" type="varchar(255)"/>
            <column name="source_uid" type="varchar(255)"/>
            <column name="source_type" type="varchar(64)"/>
            <column name="source_language" type="varchar(64)"/>
            <column name="target_language" type="varchar(64)"/>
            <column name="title" type="varchar(255)"/>
            <column name="summary" type="varchar(512)"/>
            <column name="content" type="clob"/>
            <column name="content_html" type="clob"/>
            <column name="content_markdown" type="clob"/>
            <column name="tag_list" type="clob"/>
            <column name="translate_status" type="varchar(64)"/>
            <column name="translate_provider" type="varchar(255)"/>
            <column name="translated_at" type="datetime"/>
            <column name="error_message" type="clob"/>
            <column name="is_enabled" type="boolean" defaultValueBoolean="true"/>
            <column name="kbase_id" type="bigint"/>
        </createTable>

        <createIndex tableName="bytedesk_kbase_translation" indexName="idx_kbase_translation_kbase_source_lang">
            <column name="kbase_id"/>
            <column name="source_uid"/>
            <column name="source_type"/>
            <column name="target_language"/>
        </createIndex>

        <createIndex tableName="bytedesk_kbase_translation" indexName="idx_kbase_translation_status">
            <column name="translate_status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>