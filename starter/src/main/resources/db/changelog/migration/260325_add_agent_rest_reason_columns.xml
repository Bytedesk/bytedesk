<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260325-add-agent-rest-reason-column" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="bytedesk_service_agent" columnName="rest_reason"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_service_agent">
            <column name="rest_reason" type="varchar(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="260325-add-agent-status-rest-reason-column" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="bytedesk_service_agent_status" columnName="rest_reason"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_service_agent_status">
            <column name="rest_reason" type="varchar(255)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>