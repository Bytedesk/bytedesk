<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260713-add-ivr-record-hotline-trace-fields" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_call_ivr_record"/>
            <not>
                <columnExists tableName="bytedesk_call_ivr_record" columnName="decision_result"/>
            </not>
        </preConditions>

        <addColumn tableName="bytedesk_call_ivr_record">
            <column name="decision_result" type="VARCHAR(64)"/>
            <column name="queue_uid" type="VARCHAR(64)"/>
            <column name="queue_name" type="VARCHAR(128)"/>
            <column name="leave_message_uid" type="VARCHAR(64)"/>
            <column name="agent_uid" type="VARCHAR(64)"/>
            <column name="failure_reason" type="VARCHAR(255)"/>
        </addColumn>

        <createIndex tableName="bytedesk_call_ivr_record" indexName="idx_ivr_record_decision_result">
            <column name="decision_result"/>
        </createIndex>
        <createIndex tableName="bytedesk_call_ivr_record" indexName="idx_ivr_record_queue_name">
            <column name="queue_name"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>