<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260611-refactor-xml-curl-trace-table" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <not>
                <tableExists tableName="bytedesk_call_xml_curl_trace"/>
            </not>
        </preConditions>

        <createTable tableName="bytedesk_call_xml_curl_trace">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_bytedesk_call_xml_curl_trace" nullable="false"/>
            </column>
            <column name="uuid" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_call_xml_curl_trace_uuid"/>
            </column>
            <column name="version" type="INT" defaultValueNumeric="0"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="org_uid" type="VARCHAR(64)"/>
            <column name="user_uid" type="VARCHAR(64)"/>
            <column name="level_type" type="VARCHAR(64)"/>
            <column name="platform_type" type="VARCHAR(64)"/>
            <column name="section" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="remote" type="VARCHAR(255)"/>
            <column name="method" type="VARCHAR(16)"/>
            <column name="uri" type="VARCHAR(255)"/>
            <column name="query" type="TEXT"/>
            <column name="found" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="response_size" type="INT" defaultValueNumeric="0"/>
            <column name="cost_ms" type="BIGINT" defaultValueNumeric="0"/>
            <column name="key_fields" type="TEXT"/>
        </createTable>

        <createIndex tableName="bytedesk_call_xml_curl_trace" indexName="idx_call_xml_curl_trace_org_created">
            <column name="org_uid"/>
            <column name="created_at"/>
        </createIndex>
        <createIndex tableName="bytedesk_call_xml_curl_trace" indexName="idx_call_xml_curl_trace_section_category">
            <column name="section"/>
            <column name="category"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>