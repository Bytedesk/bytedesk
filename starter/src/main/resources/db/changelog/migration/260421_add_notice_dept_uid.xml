<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260421-add-notice-dept-uid" author="githubcopilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_core_notice"/>
            <not>
                <columnExists tableName="bytedesk_core_notice" columnName="dept_uid"/>
            </not>
        </preConditions>

        <addColumn tableName="bytedesk_core_notice">
            <column name="dept_uid" type="varchar(64)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>