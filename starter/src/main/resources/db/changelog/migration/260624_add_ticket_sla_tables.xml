<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260624-create-ticket-sla-settings" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <not>
                <tableExists tableName="bytedesk_ticket_sla_settings"/>
            </not>
        </preConditions>
        <createTable tableName="bytedesk_ticket_sla_settings">
            <column name="id" type="bigint" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="uuid" type="varchar(255)"><constraints nullable="false" unique="true"/></column>
            <column name="version" type="int" defaultValueNumeric="0"/>
            <column name="created_at" type="datetime"/>
            <column name="updated_at" type="datetime"/>
            <column name="is_deleted" type="boolean" defaultValueBoolean="false"/>
            <column name="org_uid" type="varchar(255)"/>
            <column name="user_uid" type="varchar(255)"/>
            <column name="level_type" type="varchar(255)"/>
            <column name="platform_type" type="varchar(255)"/>
            <column name="is_enabled" type="boolean" defaultValueBoolean="true"/>
            <column name="business_hours_enabled" type="boolean" defaultValueBoolean="false"/>
            <column name="business_hours_start_time" type="varchar(16)" defaultValue="09:00"/>
            <column name="business_hours_end_time" type="varchar(16)" defaultValue="18:00"/>
            <column name="business_hours_timezone" type="varchar(64)" defaultValue="Asia/Shanghai"/>
            <column name="business_hours_country_code" type="varchar(16)" defaultValue="CN"/>
            <column name="pause_on_hold" type="boolean" defaultValueBoolean="false"/>
            <column name="notify_on_breach" type="boolean" defaultValueBoolean="true"/>
            <column name="auto_escalate_enabled" type="boolean" defaultValueBoolean="false"/>
            <column name="escalate_assignee_uid" type="varchar(255)"/>
            <column name="auto_close_customer_pending_enabled" type="boolean" defaultValueBoolean="false"/>
            <column name="customer_verify_auto_close_hours" type="int" defaultValueNumeric="168"/>
            <column name="warning_percent" type="int" defaultValueNumeric="80"/>
        </createTable>
    </changeSet>

    <changeSet id="260624-add-ticket-sla-business-hours-columns" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_ticket_sla_settings"/>
            <not>
                <columnExists tableName="bytedesk_ticket_sla_settings" columnName="business_hours_start_time"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_ticket_sla_settings">
            <column name="business_hours_start_time" type="varchar(16)" defaultValue="09:00"/>
            <column name="business_hours_end_time" type="varchar(16)" defaultValue="18:00"/>
            <column name="business_hours_timezone" type="varchar(64)" defaultValue="Asia/Shanghai"/>
            <column name="business_hours_country_code" type="varchar(16)" defaultValue="CN"/>
        </addColumn>
    </changeSet>

    <changeSet id="260624-add-ticket-sla-escalate-columns" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_ticket_sla_settings"/>
            <not>
                <columnExists tableName="bytedesk_ticket_sla_settings" columnName="auto_escalate_enabled"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_ticket_sla_settings">
            <column name="auto_escalate_enabled" type="boolean" defaultValueBoolean="false"/>
            <column name="escalate_assignee_uid" type="varchar(255)"/>
            <column name="auto_close_customer_pending_enabled" type="boolean" defaultValueBoolean="false"/>
            <column name="customer_verify_auto_close_hours" type="int" defaultValueNumeric="168"/>
        </addColumn>
    </changeSet>

    <changeSet id="260624-create-ticket-sla-rule" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <not>
                <tableExists tableName="bytedesk_ticket_sla_rule"/>
            </not>
        </preConditions>
        <createTable tableName="bytedesk_ticket_sla_rule">
            <column name="id" type="bigint" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="uuid" type="varchar(255)"><constraints nullable="false" unique="true"/></column>
            <column name="version" type="int" defaultValueNumeric="0"/>
            <column name="created_at" type="datetime"/>
            <column name="updated_at" type="datetime"/>
            <column name="is_deleted" type="boolean" defaultValueBoolean="false"/>
            <column name="org_uid" type="varchar(255)"/>
            <column name="user_uid" type="varchar(255)"/>
            <column name="level_type" type="varchar(255)"/>
            <column name="platform_type" type="varchar(255)"/>
            <column name="sla_settings_uid" type="varchar(255)"/>
            <column name="sla_type" type="varchar(32)"/>
            <column name="priority" type="varchar(32)"/>
            <column name="category_uid" type="varchar(255)"/>
            <column name="duration_minutes" type="bigint"/>
            <column name="warning_minutes" type="bigint"/>
            <column name="is_enabled" type="boolean" defaultValueBoolean="true"/>
            <column name="order_index" type="int" defaultValueNumeric="0"/>
        </createTable>
        <createIndex tableName="bytedesk_ticket_sla_rule" indexName="idx_ticket_sla_rule_settings">
            <column name="sla_settings_uid"/>
        </createIndex>
    </changeSet>

    <changeSet id="260624-create-ticket-sla-record" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <not>
                <tableExists tableName="bytedesk_ticket_sla_record"/>
            </not>
        </preConditions>
        <createTable tableName="bytedesk_ticket_sla_record">
            <column name="id" type="bigint" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="uuid" type="varchar(255)"><constraints nullable="false" unique="true"/></column>
            <column name="version" type="int" defaultValueNumeric="0"/>
            <column name="created_at" type="datetime"/>
            <column name="updated_at" type="datetime"/>
            <column name="is_deleted" type="boolean" defaultValueBoolean="false"/>
            <column name="org_uid" type="varchar(255)"/>
            <column name="user_uid" type="varchar(255)"/>
            <column name="level_type" type="varchar(255)"/>
            <column name="platform_type" type="varchar(255)"/>
            <column name="ticket_uid" type="varchar(255)"/>
            <column name="process_instance_id" type="varchar(255)"/>
            <column name="sla_type" type="varchar(32)"/>
            <column name="status" type="varchar(32)"/>
            <column name="priority" type="varchar(255)"/>
            <column name="category_uid" type="varchar(255)"/>
            <column name="duration_minutes" type="bigint"/>
            <column name="started_at" type="datetime"/>
            <column name="due_at" type="datetime"/>
            <column name="paused_at" type="datetime"/>
            <column name="paused_duration_seconds" type="bigint" defaultValueNumeric="0"/>
            <column name="completed_at" type="datetime"/>
            <column name="breached_at" type="datetime"/>
            <column name="breach_reason" type="varchar(255)"/>
            <column name="completed_by" type="varchar(255)"/>
            <column name="breached" type="boolean" defaultValueBoolean="false"/>
        </createTable>
        <createIndex tableName="bytedesk_ticket_sla_record" indexName="idx_ticket_sla_record_ticket_type">
            <column name="ticket_uid"/>
            <column name="sla_type"/>
        </createIndex>
        <createIndex tableName="bytedesk_ticket_sla_record" indexName="idx_ticket_sla_record_due_at">
            <column name="due_at"/>
        </createIndex>
        <createIndex tableName="bytedesk_ticket_sla_record" indexName="idx_ticket_sla_record_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

    <changeSet id="260624-add-ticket-sla-record-pause-columns" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_ticket_sla_record"/>
            <not>
                <columnExists tableName="bytedesk_ticket_sla_record" columnName="paused_at"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_ticket_sla_record">
            <column name="paused_at" type="datetime"/>
            <column name="paused_duration_seconds" type="bigint" defaultValueNumeric="0"/>
        </addColumn>
    </changeSet>

    <changeSet id="260624-add-ticket-settings-sla-columns" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_ticket_settings"/>
            <not>
                <columnExists tableName="bytedesk_ticket_settings" columnName="sla_settings_id"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_ticket_settings">
            <column name="sla_settings_id" type="bigint"/>
            <column name="draft_sla_settings_id" type="bigint"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>