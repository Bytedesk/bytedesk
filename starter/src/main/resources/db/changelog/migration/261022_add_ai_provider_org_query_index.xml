<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        LLM 供应商表组织级查询索引（AI 模块）：

        LlmProviderInitializer 启动时按 (provider_type, level_type, org_uid, is_deleted=false)
        对每个组织做精确查询（此前为不含 orgUid 的全表列表查询，1458 组织 × 20 供应商
        产生平方级扫描）。此前表上只有主键与 uuid 唯一索引，查询计划 type=ALL 全表扫描。

        索引列顺序 (provider_type, level_type, is_deleted, org_uid) 同时覆盖：
          - provider_type + level_type + is_deleted（平台级/按类型查询）
          - provider_type + level_type + is_deleted + org_uid（组织级精确查询）

        注意：索引不能替代代码修复，仅为组织级精确查询提供执行计划支持。
        实体 LlmProviderEntity 的 @Table indexes 同步声明该索引；
        JPA ddl-auto=update 先建索引时，下方 indexExists 前置条件将 MARK_RAN 跳过。
    -->

    <changeSet id="261022-add-ai-provider-type-level-deleted-org-index" author="copilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_ai_provider"/>
                <columnExists tableName="bytedesk_ai_provider" columnName="provider_type"/>
                <columnExists tableName="bytedesk_ai_provider" columnName="level_type"/>
                <columnExists tableName="bytedesk_ai_provider" columnName="is_deleted"/>
                <columnExists tableName="bytedesk_ai_provider" columnName="org_uid"/>
                <not>
                    <indexExists tableName="bytedesk_ai_provider" indexName="idx_ai_provider_type_level_deleted_org"/>
                </not>
            </and>
        </preConditions>

        <createIndex tableName="bytedesk_ai_provider" indexName="idx_ai_provider_type_level_deleted_org">
            <column name="provider_type"/>
            <column name="level_type"/>
            <column name="is_deleted"/>
            <column name="org_uid"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="bytedesk_ai_provider" indexName="idx_ai_provider_type_level_deleted_org"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
