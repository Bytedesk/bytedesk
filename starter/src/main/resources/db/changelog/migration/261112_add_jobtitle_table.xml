<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        职务字典表（modules/core JobTitleEntity）：组织级职务选项，供成员 jobTitle 快速选择。
        跨库兼容：仅使用标准 createTable/createIndex 标签；BOOLEAN/BIGINT/VARCHAR/timestamp
        由 Liquibase 按方言映射（MySQL/PostgreSQL/H2/Oracle/KingBase）。
        active_key 为有效项唯一键（sha256 hex，64 字符），软删除时置 NULL；
        单列唯一索引允许多个 NULL（已删除项），保证同组织同名有效项唯一。
    -->

    <changeSet id="261112-10-create-jobtitle-table" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="bytedesk_core_jobtitle"/>
            </not>
        </preConditions>
        <createTable tableName="bytedesk_core_jobtitle">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="uuid" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="created_at" type="timestamp"/>
            <column name="updated_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="is_deleted" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="org_uid" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="user_uid" type="VARCHAR(64)"/>
            <column name="level_type" type="VARCHAR(255)"/>
            <column name="platform_type" type="VARCHAR(255)"/>
            <column name="name" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(255)"/>
            <column name="sort_order" type="INT"/>
            <column name="active_key" type="VARCHAR(64)"/>
        </createTable>
        <createIndex indexName="uk_jobtitle_active_key" tableName="bytedesk_core_jobtitle" unique="true">
            <column name="active_key"/>
        </createIndex>
        <createIndex indexName="idx_jobtitle_org_deleted" tableName="bytedesk_core_jobtitle">
            <column name="org_uid"/>
            <column name="is_deleted"/>
            <column name="sort_order"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
