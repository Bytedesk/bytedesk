    <changeSet id="260605-add-bridge-context" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_call_bridge"/>
                <not>
                    <columnExists tableName="bytedesk_call_bridge" columnName="bridge_context"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="bytedesk_call_bridge">
            <column name="bridge_context" type="VARCHAR(64)" defaultValue="default"/>
        </addColumn>
    </changeSet>

