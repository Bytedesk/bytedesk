<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260413-add-message-leave-form-data" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <tableExists tableName="bytedesk_service_message_leave" />
            <not>
                <columnExists tableName="bytedesk_service_message_leave" columnName="form_data" />
            </not>
        </preConditions>
        <comment>Add generic formData storage for leave messages</comment>
        <addColumn tableName="bytedesk_service_message_leave">
            <column name="form_data" type="TEXT" />
        </addColumn>
        <rollback>
            <dropColumn tableName="bytedesk_service_message_leave" columnName="form_data" />
        </rollback>
    </changeSet>

</databaseChangeLog>