    <changeSet id="260401-add-agent-seat-domain-column-shop-uid" author="copilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_service_agent_seat"/>
                <not>
                    <columnExists tableName="bytedesk_service_agent_seat" columnName="shop_uid"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="bytedesk_service_agent_seat">
            <column name="shop_uid" type="VARCHAR(64)"/>
        </addColumn>
    </changeSet>

