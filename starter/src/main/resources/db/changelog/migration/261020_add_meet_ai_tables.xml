        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="bytedesk_meet_assistant_ctx"/>
            </not>
        </preConditions>
        <createTable tableName="bytedesk_meet_assistant_ctx">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_meet_assistant_ctx" nullable="false"/>
            </column>
            <column name="uuid" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_meet_assistant_ctx_uuid"/>
            </column>
            <column name="version" type="INT" defaultValueNumeric="0"/>
            <column name="created_at" type="TIMESTAMP"/>
