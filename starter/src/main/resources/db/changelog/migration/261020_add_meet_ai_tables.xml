            <column name="level_type" type="VARCHAR(32)"/>
            <column name="platform_type" type="VARCHAR(32)"/>
            <column name="minutes_uid" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="ordinal" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="recording_uid" type="VARCHAR(64)">
