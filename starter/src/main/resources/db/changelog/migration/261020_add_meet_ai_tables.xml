    </changeSet>

    <!-- ============ 录制表：音轨覆盖范围列（可空，历史 NULL=UNKNOWN） ============ -->
    <changeSet id="261020-add-meeting-recording-audio-scope" author="copilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_webrtc_meeting_recording"/>
            <not>
                <columnExists tableName="bytedesk_webrtc_meeting_recording" columnName="audio_scope"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_webrtc_meeting_recording">
            <column name="audio_scope" type="VARCHAR(32)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
