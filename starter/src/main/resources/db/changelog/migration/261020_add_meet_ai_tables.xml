        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_meet_minutes_source"/>
            <not>
                <indexExists tableName="bytedesk_meet_minutes_source" indexName="idx_meet_minutes_source_lookup"/>
