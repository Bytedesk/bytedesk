<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260602-add-call-popup-iframe-fields" author="githubcopilot">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_call_popup" />
                <not>
                    <columnExists tableName="bytedesk_call_popup" columnName="iframe_url" />
                </not>
            </and>
        </preConditions>

        <addColumn tableName="bytedesk_call_popup">
            <column name="iframe_url" type="varchar(1024)" />
            <column name="custom_width" type="int" />
            <column name="always_visible" type="boolean" defaultValueBoolean="false" />
            <column name="enabled" type="boolean" defaultValueBoolean="true" />
            <column name="display_order" type="int" defaultValueNumeric="0" />
        </addColumn>

        <update tableName="bytedesk_call_popup">
            <column name="always_visible" valueBoolean="false" />
            <where>always_visible IS NULL</where>
        </update>

        <update tableName="bytedesk_call_popup">
            <column name="enabled" valueBoolean="true" />
            <where>enabled IS NULL</where>
        </update>

        <update tableName="bytedesk_call_popup">
            <column name="display_order" valueNumeric="0" />
            <where>display_order IS NULL</where>
        </update>
    </changeSet>

</databaseChangeLog>