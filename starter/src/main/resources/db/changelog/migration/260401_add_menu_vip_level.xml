<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260401-add-menu-vip-level" author="githubcopilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_core_menu" />
            <not>
                <columnExists tableName="bytedesk_core_menu" columnName="menu_vip_level" />
            </not>
        </preConditions>

        <addColumn tableName="bytedesk_core_menu">
            <column name="menu_vip_level" type="INT" defaultValueNumeric="0">
                <constraints nullable="false" />
            </column>
        </addColumn>

        <rollback>
            <dropColumn tableName="bytedesk_core_menu" columnName="menu_vip_level" />
        </rollback>
    </changeSet>
</databaseChangeLog>