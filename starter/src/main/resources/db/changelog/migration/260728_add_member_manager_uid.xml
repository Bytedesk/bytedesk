<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260728-add-member-manager-uid" author="bytedesk">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_team_member"/>
            <not>
                <columnExists tableName="bytedesk_team_member" columnName="manager_member_uid"/>
            </not>
        </preConditions>

        <addColumn tableName="bytedesk_team_member">
            <column name="manager_member_uid" type="VARCHAR(64)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <createIndex tableName="bytedesk_team_member" indexName="idx_member_manager_uid">
            <column name="manager_member_uid"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="bytedesk_team_member" indexName="idx_member_manager_uid"/>
            <dropColumn tableName="bytedesk_team_member" columnName="manager_member_uid"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
