<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260729-add-ticket-sla-record-node-fields" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_ticket_sla_record"/>
        </preConditions>
        <addColumn tableName="bytedesk_ticket_sla_record">
            <column name="sla_source" type="varchar(32)" defaultValue="GLOBAL"/>
            <column name="task_id" type="varchar(255)"/>
            <column name="task_definition_key" type="varchar(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="260729-add-ticket-sla-record-node-index" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_ticket_sla_record"/>
            <not>
                <indexExists tableName="bytedesk_ticket_sla_record" indexName="idx_ticket_sla_record_task"/>
            </not>
        </preConditions>
        <createIndex tableName="bytedesk_ticket_sla_record" indexName="idx_ticket_sla_record_task">
            <column name="task_id"/>
            <column name="task_definition_key"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>