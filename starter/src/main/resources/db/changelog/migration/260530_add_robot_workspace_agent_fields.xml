<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260530-add-robot-workspace-agent-fields" author="bytedesk">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_ai_robot_workspace" />
            <not>
                <columnExists tableName="bytedesk_ai_robot_workspace" columnName="robot_uid" />
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_ai_robot_workspace">
            <column name="robot_uid" type="varchar(255)" />
            <column name="thread_uid" type="varchar(255)" defaultValue="" />
            <column name="workspace_path" type="varchar(512)" />
            <column name="workspace_content" type="clob" />
            <column name="is_enabled" type="boolean" defaultValueBoolean="true" />
        </addColumn>
    </changeSet>

</databaseChangeLog>
