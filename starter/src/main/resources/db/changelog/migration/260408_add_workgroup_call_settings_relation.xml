<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260408-01-add-workgroup-call-settings-id" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_service_workgroup"/>
                <not>
                    <columnExists tableName="bytedesk_service_workgroup" columnName="call_settings_id"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="bytedesk_service_workgroup">
            <column name="call_settings_id" type="BIGINT"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="bytedesk_service_workgroup" columnName="call_settings_id"/>
        </rollback>
    </changeSet>

    <changeSet id="260408-02-add-workgroup-call-settings-index" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_service_workgroup"/>
                <columnExists tableName="bytedesk_service_workgroup" columnName="call_settings_id"/>
                <not>
                    <indexExists tableName="bytedesk_service_workgroup" indexName="idx_workgroup_call_settings_id"/>
                </not>
            </and>
        </preConditions>
        <createIndex tableName="bytedesk_service_workgroup" indexName="idx_workgroup_call_settings_id" unique="true">
            <column name="call_settings_id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="bytedesk_service_workgroup" indexName="idx_workgroup_call_settings_id"/>
        </rollback>
    </changeSet>

    <changeSet id="260408-03-add-workgroup-call-settings-fk" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_service_workgroup"/>
                <tableExists tableName="bytedesk_call_settings"/>
                <columnExists tableName="bytedesk_service_workgroup" columnName="call_settings_id"/>
                <not>
                    <foreignKeyConstraintExists foreignKeyName="fk_workgroup_call_settings"/>
                </not>
            </and>
        </preConditions>
        <addForeignKeyConstraint
            baseTableName="bytedesk_service_workgroup"
            baseColumnNames="call_settings_id"
            referencedTableName="bytedesk_call_settings"
            referencedColumnNames="id"
            constraintName="fk_workgroup_call_settings"
            onDelete="SET NULL"/>
        <rollback>
            <dropForeignKeyConstraint baseTableName="bytedesk_service_workgroup" constraintName="fk_workgroup_call_settings"/>
        </rollback>
    </changeSet>

</databaseChangeLog>