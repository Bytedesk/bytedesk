    <changeSet id="260605-add-dialplan-generated-xml-cache-fields" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_call_dialplan"/>
                <not>
                    <columnExists tableName="bytedesk_call_dialplan" columnName="source_type"/>
                </not>
                <not>
                    <columnExists tableName="bytedesk_call_dialplan" columnName="source_uid"/>
                </not>
                <not>
                    <columnExists tableName="bytedesk_call_dialplan" columnName="dialplan_context"/>
                </not>
                <not>
                    <columnExists tableName="bytedesk_call_dialplan" columnName="destination_number"/>
                </not>
                <not>
                    <columnExists tableName="bytedesk_call_dialplan" columnName="xml_content"/>
                </not>
                <not>
                    <columnExists tableName="bytedesk_call_dialplan" columnName="config_signature"/>
                </not>
                <not>
                    <columnExists tableName="bytedesk_call_dialplan" columnName="generation_note"/>
                </not>
            </and>
        </preConditions>

        <addColumn tableName="bytedesk_call_dialplan">
            <column name="source_type" type="VARCHAR(64)"/>
            <column name="source_uid" type="VARCHAR(64)"/>
            <column name="dialplan_context" type="VARCHAR(64)"/>
            <column name="destination_number" type="VARCHAR(128)"/>
            <column name="xml_content" type="TEXT"/>
            <column name="config_signature" type="TEXT"/>
            <column name="generation_note" type="TEXT"/>
        </addColumn>
    </changeSet>

