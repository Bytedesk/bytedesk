<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260326-add-shop-access-token" author="copilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_core_shop"/>
                <not><columnExists tableName="bytedesk_core_shop" columnName="access_token"/></not>
            </and>
        </preConditions>
        <addColumn tableName="bytedesk_core_shop">
            <column name="access_token" type="VARCHAR(1024)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>