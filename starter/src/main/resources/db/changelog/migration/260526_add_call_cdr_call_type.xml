<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260526-add-call-cdr-call-type" author="githubcopilot">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_call_cdr" />
                <not>
                    <columnExists tableName="bytedesk_call_cdr" columnName="call_type" />
                </not>
            </and>
        </preConditions>

        <addColumn tableName="bytedesk_call_cdr">
            <column name="call_type" type="varchar(32)" />
        </addColumn>
    </changeSet>

</databaseChangeLog>