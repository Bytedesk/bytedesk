<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260518-add-call-settings-agent-uid" author="githubcopilot">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_call_settings" />
                <not>
                    <columnExists tableName="bytedesk_call_settings" columnName="agent_uid" />
                </not>
            </and>
        </preConditions>

        <addColumn tableName="bytedesk_call_settings">
            <column name="agent_uid" type="varchar(64)" />
        </addColumn>

        <createIndex tableName="bytedesk_call_settings" indexName="idx_call_settings_agent_uid">
            <column name="agent_uid" />
        </createIndex>
    </changeSet>

    <changeSet id="260518-backfill-call-settings-agent-uid" author="githubcopilot">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_call_settings" />
                <tableExists tableName="bytedesk_service_agent" />
                <columnExists tableName="bytedesk_call_settings" columnName="agent_uid" />
                <columnExists tableName="bytedesk_service_agent" columnName="call_settings_id" />
            </and>
        </preConditions>

        <sql>
            UPDATE bytedesk_call_settings cs
            INNER JOIN bytedesk_service_agent a ON a.call_settings_id = cs.id
            SET cs.agent_uid = a.uuid
            WHERE cs.agent_uid IS NULL OR cs.agent_uid = '';
        </sql>
    </changeSet>

    <changeSet id="260518-drop-agent-call-settings-foreign-key" author="githubcopilot">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_service_agent" />
                <columnExists tableName="bytedesk_service_agent" columnName="call_settings_id" />
            </and>
        </preConditions>

        <sql dbms="mysql" splitStatements="true" endDelimiter=";">
            SET @call_settings_fk := (
                SELECT kcu.CONSTRAINT_NAME
                FROM information_schema.KEY_COLUMN_USAGE kcu
                WHERE kcu.TABLE_SCHEMA = DATABASE()
                  AND kcu.TABLE_NAME = 'bytedesk_service_agent'
                  AND kcu.COLUMN_NAME = 'call_settings_id'
                  AND kcu.REFERENCED_TABLE_NAME IS NOT NULL
                LIMIT 1
            );
            SET @drop_call_settings_fk_sql := IF(
                @call_settings_fk IS NOT NULL,
                CONCAT('ALTER TABLE bytedesk_service_agent DROP FOREIGN KEY ', @call_settings_fk),
                'SELECT 1'
            );
            PREPARE stmt FROM @drop_call_settings_fk_sql;
            EXECUTE stmt;
            DEALLOCATE PREPARE stmt;
        </sql>
    </changeSet>

    <changeSet id="260518-drop-agent-call-settings-column" author="githubcopilot">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_service_agent" />
                <columnExists tableName="bytedesk_service_agent" columnName="call_settings_id" />
            </and>
        </preConditions>

        <dropColumn tableName="bytedesk_service_agent" columnName="call_settings_id" />
    </changeSet>

</databaseChangeLog>
