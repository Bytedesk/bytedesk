<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260604-add-time-condition-detail-table" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <not>
                <tableExists tableName="bytedesk_call_time_condition_detail"/>
            </not>
        </preConditions>

        <createTable tableName="bytedesk_call_time_condition_detail">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_bytedesk_call_time_condition_detail" nullable="false"/>
            </column>
            <column name="uuid" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_call_time_condition_detail_uuid"/>
            </column>
            <column name="version" type="INT" defaultValueNumeric="0"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="org_uid" type="VARCHAR(64)"/>
            <column name="user_uid" type="VARCHAR(64)"/>
            <column name="level_type" type="VARCHAR(64)"/>
            <column name="platform_type" type="VARCHAR(64)"/>
            <column name="time_condition_uid" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="group_no" type="INT" defaultValueNumeric="0"/>
            <column name="sort_order" type="INT" defaultValueNumeric="0"/>
            <column name="condition_field" type="VARCHAR(64)"/>
            <column name="start_value" type="VARCHAR(128)"/>
            <column name="end_value" type="VARCHAR(128)"/>
            <column name="match_value" type="VARCHAR(512)"/>
        </createTable>

        <createIndex tableName="bytedesk_call_time_condition_detail" indexName="idx_call_time_condition_detail_parent">
            <column name="time_condition_uid"/>
        </createIndex>
        <createIndex tableName="bytedesk_call_time_condition_detail" indexName="idx_call_time_condition_detail_org_uid">
            <column name="org_uid"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>