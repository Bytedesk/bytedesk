<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260724-add-call-cdr-call-uuid" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_call_cdr"/>
                <not>
                    <columnExists tableName="bytedesk_call_cdr" columnName="call_uuid"/>
                </not>
            </and>
        </preConditions>

        <addColumn tableName="bytedesk_call_cdr">
            <column name="call_uuid" type="VARCHAR(64)"/>
        </addColumn>
    </changeSet>

    <changeSet id="260724-add-acd-queue-entry-call-uuid" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_call_acd_queue_entry"/>
                <not>
                    <columnExists tableName="bytedesk_call_acd_queue_entry" columnName="call_uuid"/>
                </not>
            </and>
        </preConditions>

        <addColumn tableName="bytedesk_call_acd_queue_entry">
            <column name="call_uuid" type="VARCHAR(64)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>