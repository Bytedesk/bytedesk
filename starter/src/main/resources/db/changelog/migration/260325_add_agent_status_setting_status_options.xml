    <changeSet id="260325-add-agent-status-setting-rest-enabled" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_service_agent_status_setting"/>
            <not>
                <columnExists tableName="bytedesk_service_agent_status_setting" columnName="rest_enabled"/>
            </not>
        </preConditions>

        <addColumn tableName="bytedesk_service_agent_status_setting">
            <column name="rest_enabled" type="BOOLEAN" defaultValueBoolean="true"/>
        </addColumn>

