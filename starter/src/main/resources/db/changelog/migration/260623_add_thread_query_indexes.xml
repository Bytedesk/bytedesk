    <changeSet id="260623-add-thread-org-updated-index" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_core_thread"/>
            <columnExists tableName="bytedesk_core_thread" columnName="org_uid"/>
            <columnExists tableName="bytedesk_core_thread" columnName="is_deleted"/>
            <columnExists tableName="bytedesk_core_thread" columnName="is_hide"/>
            <columnExists tableName="bytedesk_core_thread" columnName="updated_at"/>
            <not>
                <indexExists tableName="bytedesk_core_thread" indexName="idx_thread_org_updated"/>
            </not>
        </preConditions>

        <createIndex tableName="bytedesk_core_thread" indexName="idx_thread_org_updated">
            <column name="org_uid"/>
            <column name="is_deleted"/>
            <column name="is_hide"/>
            <column name="updated_at"/>
