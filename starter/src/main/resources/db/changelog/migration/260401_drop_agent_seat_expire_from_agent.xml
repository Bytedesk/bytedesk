<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260401-drop-agent-seat-expire-at-from-agent" author="copilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_service_agent"/>
                <columnExists tableName="bytedesk_service_agent" columnName="seat_expire_at"/>
            </and>
        </preConditions>
        <dropColumn tableName="bytedesk_service_agent" columnName="seat_expire_at"/>
    </changeSet>

</databaseChangeLog>