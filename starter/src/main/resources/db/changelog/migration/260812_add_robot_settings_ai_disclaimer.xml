<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        为 bytedesk_ai_robot_settings 新增 AI 免责声明相关字段。
        - hide_ai_disclaimer: 是否隐藏访客端机器人消息底部的"内容由AI生成"提示，默认 false（显示）。
        - ai_disclaimer_text: 自定义免责声明文案，为空时访客端回退到 i18n 默认值。
        背景：RobotBubble 原本无条件显示免责声明，现支持在 RobotSettings 中控制开关和自定义文案。
    -->
    <changeSet id="260812-1-add-robot-settings-hide-ai-disclaimer" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_ai_robot_settings"/>
            <not>
                <columnExists tableName="bytedesk_ai_robot_settings" columnName="hide_ai_disclaimer"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_ai_robot_settings">
            <column name="hide_ai_disclaimer" type="BIT(1)" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="260812-2-add-robot-settings-ai-disclaimer-text" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_ai_robot_settings"/>
            <not>
                <columnExists tableName="bytedesk_ai_robot_settings" columnName="ai_disclaimer_text"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_ai_robot_settings">
            <column name="ai_disclaimer_text" type="VARCHAR(500)" defaultValue="">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!--
        回填历史数据：将 hide_ai_disclaimer 为 NULL 的记录设为 false。
        虽然带 defaultValue 的 ADD COLUMN 通常会回填，但为兼容其它数据库统一回填一次。幂等。
    -->
    <changeSet id="260812-3-backfill-robot-settings-hide-ai-disclaimer" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_ai_robot_settings"/>
            <columnExists tableName="bytedesk_ai_robot_settings" columnName="hide_ai_disclaimer"/>
        </preConditions>
        <update tableName="bytedesk_ai_robot_settings">
            <column name="hide_ai_disclaimer" valueBoolean="false"/>
            <where>hide_ai_disclaimer IS NULL</where>
        </update>
    </changeSet>

</databaseChangeLog>
