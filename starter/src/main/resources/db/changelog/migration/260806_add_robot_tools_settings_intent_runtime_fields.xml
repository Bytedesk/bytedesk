<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260806-2-add-robot-tools-settings-intent-runtime-fields" author="copilot">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_ai_robot_tools_settings" />
            <not>
                <columnExists tableName="bytedesk_ai_robot_tools_settings" columnName="intent_model" />
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_ai_robot_tools_settings">
            <column name="intent_model" type="varchar(255)" />
        </addColumn>
    </changeSet>

    <changeSet id="260806-2-1-add-robot-tools-settings-intent-provider" author="copilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_ai_robot_tools_settings" />
            <not>
                <columnExists tableName="bytedesk_ai_robot_tools_settings" columnName="intent_provider" />
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_ai_robot_tools_settings">
            <column name="intent_provider" type="varchar(64)" />
        </addColumn>
    </changeSet>

    <changeSet id="260806-2-2-add-robot-tools-settings-intent-timeout-ms" author="copilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_ai_robot_tools_settings" />
            <not>
                <columnExists tableName="bytedesk_ai_robot_tools_settings" columnName="intent_timeout_ms" />
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_ai_robot_tools_settings">
            <column name="intent_timeout_ms" type="int" defaultValueNumeric="1500" />
        </addColumn>
    </changeSet>

</databaseChangeLog>