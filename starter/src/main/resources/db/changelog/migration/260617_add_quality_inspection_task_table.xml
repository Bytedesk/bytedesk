<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260617-create-quality-inspection-task-table" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <not>
                <tableExists tableName="bytedesk_service_quality_inspection_task"/>
            </not>
        </preConditions>

        <createTable tableName="bytedesk_service_quality_inspection_task">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_service_quality_inspection_task" nullable="false"/>
            </column>
            <column name="uuid" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_service_quality_inspection_task_uuid"/>
            </column>
            <column name="version" type="INT" defaultValueNumeric="0"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="org_uid" type="VARCHAR(64)"/>
            <column name="user_uid" type="VARCHAR(64)"/>
            <column name="level_type" type="VARCHAR(64)"/>
            <column name="platform_type" type="VARCHAR(64)"/>
            <column name="name" type="VARCHAR(255)"/>
            <column name="plan_uid" type="VARCHAR(64)"/>
            <column name="plan_version" type="INT" defaultValueNumeric="1"/>
            <column name="object_type" type="VARCHAR(64)"/>
            <column name="object_uid" type="VARCHAR(64)"/>
            <column name="status" type="VARCHAR(64)"/>
            <column name="retry_count" type="INT" defaultValueNumeric="0"/>
            <column name="failure_reason" type="VARCHAR(2000)"/>
            <column name="trigger_type" type="VARCHAR(64)"/>
            <column name="started_at" type="TIMESTAMP"/>
            <column name="finished_at" type="TIMESTAMP"/>
            <column name="target_count" type="INT" defaultValueNumeric="0"/>
            <column name="success_count" type="INT" defaultValueNumeric="0"/>
        </createTable>

        <createIndex tableName="bytedesk_service_quality_inspection_task" indexName="idx_quality_inspection_task_org_status_deleted">
            <column name="org_uid"/>
            <column name="status"/>
            <column name="is_deleted"/>
        </createIndex>

        <createIndex tableName="bytedesk_service_quality_inspection_task" indexName="idx_quality_inspection_task_plan_trigger">
            <column name="plan_uid"/>
            <column name="trigger_type"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>