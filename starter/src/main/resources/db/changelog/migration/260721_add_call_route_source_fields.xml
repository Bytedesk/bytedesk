<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- New approach: separate changesets with column-exists guards.
         Previous single-changeset version could not recover from partial execution
         (e.g. column exists but INDEX failed, leaving DATABASECHANGELOG without
         a record for the already-applied ALTER TABLE).
         See plan 0-X8 / 0-X9 for the soft-idempotent design decision. -->

    <changeSet id="260721-add-call-route-source-type" author="githubcopilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_route"/>
            <not>
                <columnExists tableName="bytedesk_call_route" columnName="source_type"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_call_route">
            <column name="source_type" type="VARCHAR(64)"/>
        </addColumn>
    </changeSet>

    <changeSet id="260721-add-call-route-source-uid" author="githubcopilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_route"/>
            <not>
                <columnExists tableName="bytedesk_call_route" columnName="source_uid"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_call_route">
            <column name="source_uid" type="VARCHAR(64)"/>
        </addColumn>
    </changeSet>

    <changeSet id="260721-add-call-route-managed-by-system" author="githubcopilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_route"/>
            <not>
                <columnExists tableName="bytedesk_call_route" columnName="managed_by_system"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_call_route">
            <column name="managed_by_system" type="BOOLEAN" defaultValueBoolean="false"/>
        </addColumn>
    </changeSet>

    <changeSet id="260721-add-call-route-indexes" author="githubcopilot">
        <!-- validCheckSum: accept new checksum after removing non-existent 'deleted' column from idx_call_route_org_source -->
        <validCheckSum>9:fe8bb7cbbddfed0e1bec5c8393087f41</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_route"/>
            <columnExists tableName="bytedesk_call_route" columnName="source_type"/>
            <columnExists tableName="bytedesk_call_route" columnName="source_uid"/>
            <not>
                <indexExists tableName="bytedesk_call_route" indexName="idx_call_route_source_type"/>
            </not>
        </preConditions>

        <createIndex tableName="bytedesk_call_route" indexName="idx_call_route_source_type">
            <column name="source_type"/>
        </createIndex>

        <createIndex tableName="bytedesk_call_route" indexName="idx_call_route_source_uid">
            <column name="source_uid"/>
        </createIndex>

        <createIndex tableName="bytedesk_call_route" indexName="idx_call_route_org_source">
            <column name="org_uid"/>
            <column name="source_type"/>
            <column name="source_uid"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="bytedesk_call_route" indexName="idx_call_route_org_source"/>
            <dropIndex tableName="bytedesk_call_route" indexName="idx_call_route_source_uid"/>
            <dropIndex tableName="bytedesk_call_route" indexName="idx_call_route_source_type"/>
        </rollback>
    </changeSet>

    <!-- Separate changeset to create idx_call_route_org_source for databases
         where the original changeset partially failed (idx_call_route_source_type
         and idx_call_route_source_uid were created, but idx_call_route_org_source
         failed because the non-existent 'deleted' column was referenced). -->
    <changeSet id="260721-add-call-route-org_source-index" author="githubcopilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_route"/>
            <columnExists tableName="bytedesk_call_route" columnName="org_uid"/>
            <columnExists tableName="bytedesk_call_route" columnName="source_type"/>
            <columnExists tableName="bytedesk_call_route" columnName="source_uid"/>
            <not>
                <indexExists tableName="bytedesk_call_route" indexName="idx_call_route_org_source"/>
            </not>
        </preConditions>

        <createIndex tableName="bytedesk_call_route" indexName="idx_call_route_org_source">
            <column name="org_uid"/>
            <column name="source_type"/>
            <column name="source_uid"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="bytedesk_call_route" indexName="idx_call_route_org_source"/>
        </rollback>
    </changeSet>

</databaseChangeLog>