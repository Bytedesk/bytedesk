<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260709-add-kbase-i18n-config-fields" author="bytedesk">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_kbase" />
            <not>
                <columnExists tableName="bytedesk_kbase" columnName="source_language" />
            </not>
        </preConditions>

        <addColumn tableName="bytedesk_kbase">
            <column name="source_language" type="varchar(64)" defaultValue="ZH_CN" />
            <column name="target_languages" type="clob" />
            <column name="is_auto_translate_enabled" type="boolean" defaultValueBoolean="false" />
            <column name="is_translate_query_enabled" type="boolean" defaultValueBoolean="false" />
            <column name="is_answer_with_user_language" type="boolean" defaultValueBoolean="false" />
        </addColumn>

        <rollback>
            <dropColumn tableName="bytedesk_kbase" columnName="is_answer_with_user_language" />
            <dropColumn tableName="bytedesk_kbase" columnName="is_translate_query_enabled" />
            <dropColumn tableName="bytedesk_kbase" columnName="is_auto_translate_enabled" />
            <dropColumn tableName="bytedesk_kbase" columnName="target_languages" />
            <dropColumn tableName="bytedesk_kbase" columnName="source_language" />
        </rollback>
    </changeSet>

</databaseChangeLog>