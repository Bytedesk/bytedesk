<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260316-reconcile-call-esl-event-headers-json-to-text" author="jackning">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_call_esl_event"/>
            <columnExists tableName="bytedesk_call_esl_event" columnName="headers_json"/>
        </preConditions>
        <modifyDataType tableName="bytedesk_call_esl_event" columnName="headers_json" newDataType="TEXT"/>
        <rollback>
            <modifyDataType tableName="bytedesk_call_esl_event" columnName="headers_json" newDataType="VARCHAR(255)"/>
        </rollback>
    </changeSet>

    <changeSet id="260316-reconcile-call-esl-event-body-json-to-text" author="jackning">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_call_esl_event"/>
            <columnExists tableName="bytedesk_call_esl_event" columnName="body_json"/>
        </preConditions>
        <modifyDataType tableName="bytedesk_call_esl_event" columnName="body_json" newDataType="TEXT"/>
        <rollback>
            <modifyDataType tableName="bytedesk_call_esl_event" columnName="body_json" newDataType="VARCHAR(255)"/>
        </rollback>
    </changeSet>

</databaseChangeLog>