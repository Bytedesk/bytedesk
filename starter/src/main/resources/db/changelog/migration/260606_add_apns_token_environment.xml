<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260606-01-add-apns-token-environment" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_core_apns_token" />
            <not>
                <columnExists tableName="bytedesk_core_apns_token" columnName="environment" />
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_core_apns_token">
            <column name="environment" type="varchar(32)" defaultValue="DEVELOPMENT" />
        </addColumn>
    </changeSet>

</databaseChangeLog>