<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260424-add-ai-ocr-task-type" author="github-copilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_ai_ocr" />
            <not>
                <columnExists tableName="bytedesk_ai_ocr" columnName="task_type" />
            </not>
        </preConditions>

        <addColumn tableName="bytedesk_ai_ocr">
            <column name="task_type" type="varchar(64)" defaultValue="TEXT_EXTRACTION" remarks="OCR task type" />
        </addColumn>

    </changeSet>

    <changeSet id="260424-add-ai-ocr-question" author="github-copilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_ai_ocr" />
            <not>
                <columnExists tableName="bytedesk_ai_ocr" columnName="question" />
            </not>
        </preConditions>

        <addColumn tableName="bytedesk_ai_ocr">
            <column name="question" type="text" remarks="Question used for image recognition" />
        </addColumn>
    </changeSet>

</databaseChangeLog>