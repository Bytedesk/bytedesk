    <changeSet id="260729-create-voice-clone-table" author="github-copilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <not>
                <tableExists tableName="bytedesk_core_voice_clone" />
            </not>
        </preConditions>

        <createTable tableName="bytedesk_core_voice_clone">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_bytedesk_core_voice_clone" nullable="false" />
            </column>
            <column name="uuid" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_voice_clone_uuid" />
            </column>
            <column name="version" type="INT" defaultValueNumeric="0" />
            <column name="created_at" type="TIMESTAMP" />
            <column name="updated_at" type="TIMESTAMP" />
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false" />
            <column name="org_uid" type="VARCHAR(64)" />
            <column name="user_uid" type="VARCHAR(64)" />
            <column name="level_type" type="VARCHAR(64)" defaultValue="ORGANIZATION" />
            <column name="platform_type" type="VARCHAR(64)" defaultValue="BYTEDESK" />
            <column name="name" type="VARCHAR(255)" />
            <column name="description" type="TEXT" />
            <column name="voice_clone_type" type="VARCHAR(64)" defaultValue="CUSTOMER" />
            <column name="provider" type="VARCHAR(64)" defaultValue="dashscope" />
            <column name="clone_type" type="VARCHAR(32)" defaultValue="CLONE" />
            <column name="target_model" type="VARCHAR(128)" />
            <column name="audio_url" type="TEXT" />
            <column name="voice_prompt" type="TEXT" />
            <column name="preview_text" type="VARCHAR(1024)" />
            <column name="prefix" type="VARCHAR(128)" />
            <column name="voice_id" type="VARCHAR(256)" />
            <column name="voice_name" type="VARCHAR(256)" />
            <column name="preview_audio_url" type="TEXT" />
            <column name="status" type="VARCHAR(32)" defaultValue="PENDING" />
            <column name="request_id" type="VARCHAR(128)" />
            <column name="error_message" type="TEXT" />
        </createTable>
    </changeSet>

