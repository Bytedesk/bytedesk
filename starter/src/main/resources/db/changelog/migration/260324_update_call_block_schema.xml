    <changeSet id="260324-call-block-01-add-country" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_call_block"/>
            <not>
                <columnExists tableName="bytedesk_call_block" columnName="country"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_call_block">
            <column name="country" type="varchar(32)" defaultValue="86"/>
        </addColumn>
    </changeSet>

