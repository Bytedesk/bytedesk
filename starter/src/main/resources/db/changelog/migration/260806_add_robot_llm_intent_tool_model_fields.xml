<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260806-3-add-robot-llm-intent-tool-model-fields" author="copilot">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_ai_robot"/>
            <not>
                <and>
                    <columnExists tableName="bytedesk_ai_robot" columnName="llm_intent_provider"/>
                    <columnExists tableName="bytedesk_ai_robot" columnName="llm_intent_model"/>
                    <columnExists tableName="bytedesk_ai_robot" columnName="llm_tool_provider"/>
                    <columnExists tableName="bytedesk_ai_robot" columnName="llm_tool_model"/>
                </and>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_ai_robot">
            <column name="llm_intent_provider" type="varchar(64)" />
            <column name="llm_intent_model" type="varchar(255)" />
            <column name="llm_tool_provider" type="varchar(64)" />
            <column name="llm_tool_model" type="varchar(255)" />
        </addColumn>
    </changeSet>

</databaseChangeLog>