<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260728-add-thread-rating-resolved-tracking-fields" author="bytedesk">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_service_thread_rating"/>
        </preConditions>

        <addColumn tableName="bytedesk_service_thread_rating">
            <column name="rating_submitted" type="boolean" defaultValueBoolean="true">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <addColumn tableName="bytedesk_service_thread_rating">
            <column name="resolved_source" type="varchar(64)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <addColumn tableName="bytedesk_service_thread_rating">
            <column name="resolved_at" type="timestamp">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <update tableName="bytedesk_service_thread_rating">
            <column name="rating_submitted" valueBoolean="true"/>
            <where>rating_submitted IS NULL</where>
        </update>

        <addNotNullConstraint tableName="bytedesk_service_thread_rating"
            columnName="rating_submitted"
            columnDataType="boolean"/>

        <rollback>
            <dropColumn tableName="bytedesk_service_thread_rating" columnName="resolved_at"/>
            <dropColumn tableName="bytedesk_service_thread_rating" columnName="resolved_source"/>
            <dropColumn tableName="bytedesk_service_thread_rating" columnName="rating_submitted"/>
        </rollback>
    </changeSet>

    <changeSet id="260728-add-thread-closed-at" author="bytedesk">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="bytedesk_core_thread"/>
            <not>
                <columnExists tableName="bytedesk_core_thread" columnName="closed_at"/>
            </not>
        </preConditions>

        <addColumn tableName="bytedesk_core_thread">
            <column name="closed_at" type="timestamp">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <rollback>
            <dropColumn tableName="bytedesk_core_thread" columnName="closed_at"/>
        </rollback>
    </changeSet>

</databaseChangeLog>