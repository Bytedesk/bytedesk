<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260320-add-shop-edition" author="copilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_core_shop"/>
                <not><columnExists tableName="bytedesk_core_shop" columnName="edition"/></not>
            </and>
        </preConditions>
        <addColumn tableName="bytedesk_core_shop">
            <column name="edition" type="VARCHAR(32)" defaultValue="BASIC">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="260320-add-shop-base-agent-seats" author="copilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_core_shop"/>
                <not><columnExists tableName="bytedesk_core_shop" columnName="base_agent_seats"/></not>
            </and>
        </preConditions>
        <addColumn tableName="bytedesk_core_shop">
            <column name="base_agent_seats" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="260320-add-shop-extra-agent-seats" author="copilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_core_shop"/>
                <not><columnExists tableName="bytedesk_core_shop" columnName="extra_agent_seats"/></not>
            </and>
        </preConditions>
        <addColumn tableName="bytedesk_core_shop">
            <column name="extra_agent_seats" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="260320-add-shop-agent-seat-expire-at" author="copilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_core_shop"/>
                <not><columnExists tableName="bytedesk_core_shop" columnName="agent_seat_expire_at"/></not>
            </and>
        </preConditions>
        <addColumn tableName="bytedesk_core_shop">
            <column name="agent_seat_expire_at" type="TIMESTAMP"/>
        </addColumn>
    </changeSet>

    <changeSet id="260320-add-shop-edition-expire-at" author="copilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_core_shop"/>
                <not><columnExists tableName="bytedesk_core_shop" columnName="edition_expire_at"/></not>
            </and>
        </preConditions>
        <addColumn tableName="bytedesk_core_shop">
            <column name="edition_expire_at" type="TIMESTAMP"/>
        </addColumn>
    </changeSet>

    <changeSet id="260320-backfill-shop-seat-fields" author="copilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_core_shop"/>
        </preConditions>
        <sql>
            UPDATE bytedesk_core_shop
            SET edition = COALESCE(edition, 'BASIC'),
                base_agent_seats = COALESCE(base_agent_seats, 1),
                extra_agent_seats = COALESCE(extra_agent_seats, 0)
            WHERE 1 = 1;
        </sql>
    </changeSet>

    <changeSet id="260320-add-agent-seat-expire-at" author="copilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and>
                <tableExists tableName="bytedesk_service_agent"/>
                <not><columnExists tableName="bytedesk_service_agent" columnName="seat_expire_at"/></not>
            </and>
        </preConditions>
        <addColumn tableName="bytedesk_service_agent">
            <column name="seat_expire_at" type="TIMESTAMP"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
