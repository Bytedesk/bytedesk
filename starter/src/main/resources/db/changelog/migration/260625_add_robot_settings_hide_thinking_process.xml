<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260625-add-robot-settings-hide-thinking-process" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_ai_robot_settings"/>
            <not>
                <columnExists tableName="bytedesk_ai_robot_settings" columnName="hide_thinking_process"/>
            </not>
        </preConditions>
        <addColumn tableName="bytedesk_ai_robot_settings">
            <column name="hide_thinking_process" type="boolean" defaultValueBoolean="false"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>