<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        论坛群关系表（帖子/评论/点赞），对应 modules/core GroupForum*Entity：
        正文真值存于消息表，本组表维护可索引关系与作者快照。
        跨库兼容：仅使用标准 createTable/createIndex 标签；
        BOOLEAN/BIGINT/VARCHAR/timestamp 由 Liquibase 按方言映射（MySQL/PostgreSQL/H2/Oracle/KingBase）。
    -->

    <changeSet id="261107-10-create-group-forum-post" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="bytedesk_group_forum_post"/>
            </not>
        </preConditions>
        <createTable tableName="bytedesk_group_forum_post">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="uuid" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="created_at" type="timestamp"/>
            <column name="updated_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="is_deleted" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="org_uid" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="user_uid" type="VARCHAR(64)"/>
            <column name="level_type" type="VARCHAR(255)"/>
            <column name="platform_type" type="VARCHAR(255)"/>
            <column name="group_uid" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="message_uid" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="author_user_uid" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)"/>
        </createTable>
        <createIndex indexName="idx_gfp_group_created" tableName="bytedesk_group_forum_post">
            <column name="org_uid"/>
            <column name="group_uid"/>
            <column name="is_deleted"/>
            <column name="created_at"/>
        </createIndex>
        <createIndex indexName="idx_gfp_message" tableName="bytedesk_group_forum_post" unique="true">
            <column name="message_uid"/>
        </createIndex>
    </changeSet>

    <changeSet id="261107-11-create-group-forum-comment" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="bytedesk_group_forum_comment"/>
            </not>
        </preConditions>
        <createTable tableName="bytedesk_group_forum_comment">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="uuid" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="created_at" type="timestamp"/>
            <column name="updated_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="is_deleted" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="org_uid" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="user_uid" type="VARCHAR(64)"/>
            <column name="level_type" type="VARCHAR(255)"/>
            <column name="platform_type" type="VARCHAR(255)"/>
            <column name="group_uid" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="post_uid" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="post_message_uid" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="message_uid" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="parent_comment_uid" type="VARCHAR(64)"/>
            <column name="reply_to_user_uid" type="VARCHAR(64)"/>
            <column name="author_user_uid" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="author_nickname" type="VARCHAR(128)"/>
            <column name="author_avatar" type="VARCHAR(512)"/>
        </createTable>
        <createIndex indexName="idx_gfc_post_created" tableName="bytedesk_group_forum_comment">
            <column name="org_uid"/>
            <column name="post_uid"/>
            <column name="is_deleted"/>
            <column name="created_at"/>
        </createIndex>
        <createIndex indexName="idx_gfc_parent_created" tableName="bytedesk_group_forum_comment">
            <column name="org_uid"/>
            <column name="parent_comment_uid"/>
            <column name="is_deleted"/>
            <column name="created_at"/>
        </createIndex>
        <createIndex indexName="idx_gfc_message" tableName="bytedesk_group_forum_comment" unique="true">
            <column name="message_uid"/>
        </createIndex>
    </changeSet>

    <changeSet id="261107-12-create-group-forum-like" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="bytedesk_group_forum_like"/>
            </not>
        </preConditions>
        <createTable tableName="bytedesk_group_forum_like">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="uuid" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="created_at" type="timestamp"/>
            <column name="updated_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="is_deleted" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="org_uid" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="user_uid" type="VARCHAR(64)"/>
            <column name="level_type" type="VARCHAR(255)"/>
            <column name="platform_type" type="VARCHAR(255)"/>
            <column name="group_uid" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="post_uid" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_gfl_post" tableName="bytedesk_group_forum_like">
            <column name="org_uid"/>
            <column name="post_uid"/>
        </createIndex>
        <addUniqueConstraint tableName="bytedesk_group_forum_like"
            constraintName="uk_gfl_post_user"
            columnNames="post_uid, user_uid"/>
    </changeSet>
</databaseChangeLog>
