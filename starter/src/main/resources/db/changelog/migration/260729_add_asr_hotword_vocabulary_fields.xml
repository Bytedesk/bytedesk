    <changeSet id="260729-create-asr-hotword-table" author="github-copilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <not>
                <tableExists tableName="bytedesk_ai_asr_hotword" />
            </not>
        </preConditions>

        <createTable tableName="bytedesk_ai_asr_hotword">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_bytedesk_ai_asr_hotword" nullable="false" />
            </column>
            <column name="uuid" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_asr_hotword_uuid" />
            </column>
            <column name="version" type="INT" defaultValueNumeric="0" />
            <column name="created_at" type="TIMESTAMP" />
            <column name="updated_at" type="TIMESTAMP" />
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false" />
            <column name="org_uid" type="VARCHAR(64)" />
            <column name="user_uid" type="VARCHAR(64)" />
            <column name="level_type" type="VARCHAR(64)" defaultValue="ORGANIZATION" />
            <column name="platform_type" type="VARCHAR(64)" defaultValue="BYTEDESK" />
            <column name="name" type="VARCHAR(255)" />
            <column name="description" type="TEXT" />
            <column name="asr_hotword_type" type="VARCHAR(64)" defaultValue="CUSTOMER" />
            <column name="provider" type="VARCHAR(64)" defaultValue="dashscope" />
            <column name="target_model" type="VARCHAR(128)" />
            <column name="prefix" type="VARCHAR(128)" />
            <column name="vocabulary_id" type="VARCHAR(256)" />
            <column name="status" type="VARCHAR(32)" defaultValue="PENDING" />
            <column name="vocabulary_json" type="TEXT" />
            <column name="request_id" type="VARCHAR(128)" />
            <column name="error_message" type="TEXT" />
            <column name="raw_response" type="TEXT" />
            <column name="remote_gmt_create" type="VARCHAR(64)" />
            <column name="remote_gmt_modified" type="VARCHAR(64)" />
        </createTable>
    </changeSet>

