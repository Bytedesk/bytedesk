<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="260722-create-extension-settings-voicemail-table" author="githubcopilot">
        <validCheckSum>9:0367df21b4f77d6a3d9930ce7dc2f546</validCheckSum>
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <not>
                <tableExists tableName="bytedesk_call_extension_settings_voicemail" />
            </not>
        </preConditions>

        <createTable tableName="bytedesk_call_extension_settings_voicemail">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="uuid" type="varchar(64)">
                <constraints nullable="false" />
            </column>
            <column name="org_uid" type="varchar(64)" />
            <column name="user_uid" type="varchar(64)" />
            <column name="level_type" type="varchar(32)" />
            <column name="platform_type" type="varchar(32)" />
            <column name="is_deleted" type="boolean" defaultValueBoolean="false" />
            <column name="created_at" type="datetime" />
            <column name="updated_at" type="datetime" />

            <column name="enable_voicemail" type="boolean" defaultValueBoolean="true" />
            <column name="voicemail_prompt" type="text" />
            <column name="max_record_seconds" type="int" defaultValueNumeric="120" />
            <column name="enable_dtmf_menu" type="boolean" defaultValueBoolean="true" />
            <column name="dtmf_escape_digit" type="varchar(16)" defaultValue="*" />
        </createTable>

        <createIndex tableName="bytedesk_call_extension_settings_voicemail" indexName="idx_ext_voicemail_settings_uid">
            <column name="uuid" />
        </createIndex>
    </changeSet>

    <changeSet id="260722-fix-voicemail-table-level-platform-columns" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_call_extension_settings_voicemail" />
            <columnExists tableName="bytedesk_call_extension_settings_voicemail" columnName="level" />
        </preConditions>
        <renameColumn tableName="bytedesk_call_extension_settings_voicemail" oldColumnName="level" newColumnName="level_type" columnDataType="varchar(32)" />
        <renameColumn tableName="bytedesk_call_extension_settings_voicemail" oldColumnName="platform" newColumnName="platform_type" columnDataType="varchar(32)" />
    </changeSet>

    <changeSet id="260722-add-voice-settings-realtime-model-columns" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_call_extension_settings_voice" />
            <not>
                <columnExists tableName="bytedesk_call_extension_settings_voice" columnName="realtime_model" />
            </not>
        </preConditions>

        <addColumn tableName="bytedesk_call_extension_settings_voice">
            <column name="realtime_model" type="varchar(128)" defaultValue="qwen-audio-3.0-realtime-plus" />
        </addColumn>
        <addColumn tableName="bytedesk_call_extension_settings_voice">
            <column name="realtime_voice" type="varchar(128)" defaultValue="longanqian" />
        </addColumn>
        <addColumn tableName="bytedesk_call_extension_settings_voice">
            <column name="tts_model" type="varchar(128)" />
        </addColumn>
        <addColumn tableName="bytedesk_call_extension_settings_voice">
            <column name="tts_voice" type="varchar(128)" />
        </addColumn>
    </changeSet>

    <changeSet id="260722-migrate-voicemail-data-to-new-table" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_call_extension_settings_voice" />
            <tableExists tableName="bytedesk_call_extension_settings_voicemail" />
        </preConditions>

        <sql>
            INSERT INTO bytedesk_call_extension_settings_voicemail
                (uuid, org_uid, user_uid, level_type, platform_type, is_deleted, created_at, updated_at,
                 enable_voicemail, voicemail_prompt, max_record_seconds, enable_dtmf_menu, dtmf_escape_digit)
            SELECT uuid, org_uid, user_uid, level_type, platform_type, is_deleted, created_at, updated_at,
                   enable_voicemail, voicemail_prompt, max_record_seconds, enable_dtmf_menu, dtmf_escape_digit
            FROM bytedesk_call_extension_settings_voice
            WHERE NOT EXISTS (
                SELECT 1 FROM bytedesk_call_extension_settings_voicemail v
                WHERE v.uuid = bytedesk_call_extension_settings_voice.uuid
            )
        </sql>
    </changeSet>

    <changeSet id="260722-drop-voice-settings-voicemail-columns" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_call_extension_settings_voice" />
            <columnExists tableName="bytedesk_call_extension_settings_voice" columnName="enable_voicemail" />
        </preConditions>

        <dropColumn tableName="bytedesk_call_extension_settings_voice" columnName="enable_voicemail" />
        <dropColumn tableName="bytedesk_call_extension_settings_voice" columnName="voicemail_prompt" />
        <dropColumn tableName="bytedesk_call_extension_settings_voice" columnName="max_record_seconds" />
        <dropColumn tableName="bytedesk_call_extension_settings_voice" columnName="enable_dtmf_menu" />
        <dropColumn tableName="bytedesk_call_extension_settings_voice" columnName="dtmf_escape_digit" />
    </changeSet>

    <changeSet id="260722-drop-knowledge-settings-realtime-model-columns" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_call_extension_settings_knowledge" />
            <columnExists tableName="bytedesk_call_extension_settings_knowledge" columnName="realtime_model" />
        </preConditions>

        <dropColumn tableName="bytedesk_call_extension_settings_knowledge" columnName="realtime_model" />
        <dropColumn tableName="bytedesk_call_extension_settings_knowledge" columnName="realtime_voice" />
        <dropColumn tableName="bytedesk_call_extension_settings_knowledge" columnName="tts_model" />
        <dropColumn tableName="bytedesk_call_extension_settings_knowledge" columnName="tts_voice" />
    </changeSet>

    <changeSet id="260722-add-extension-settings-voicemail-fk-columns" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_call_extension_settings" />
            <not>
                <columnExists tableName="bytedesk_call_extension_settings" columnName="voicemail_settings_uid" />
            </not>
        </preConditions>

        <addColumn tableName="bytedesk_call_extension_settings">
            <column name="voicemail_settings_uid" type="varchar(64)" />
        </addColumn>
        <addColumn tableName="bytedesk_call_extension_settings">
            <column name="draft_voicemail_settings_uid" type="varchar(64)" />
        </addColumn>
    </changeSet>

    <changeSet id="260722-link-existing-voicemail-to-settings" author="githubcopilot">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="bytedesk_call_extension_settings" />
            <tableExists tableName="bytedesk_call_extension_settings_voicemail" />
        </preConditions>

        <sql>
            UPDATE bytedesk_call_extension_settings s
            SET s.voicemail_settings_uid = (
                SELECT v.uuid FROM bytedesk_call_extension_settings_voicemail v
                WHERE v.uuid = s.voice_settings_uid
            )
            WHERE s.voice_settings_uid IS NOT NULL
              AND s.voicemail_settings_uid IS NULL
        </sql>
    </changeSet>

</databaseChangeLog>
